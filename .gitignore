# ============================================================
# .gitignore - 专业级 Git 忽略规则
# 项目：HID复合设备（固件 + 上位机）
# ============================================================

# ------------------------------------------------------------
# 1. 操作系统生成的文件
# ------------------------------------------------------------

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~

# ------------------------------------------------------------
# 2. IDE / 编辑器配置（个人配置，不入库）
# ------------------------------------------------------------

# Visual Studio Code
# 忽略所有 .vscode 目录
.vscode/
# 例外：根目录的 .vscode 目录（保留共享配置）
!/.vscode/
# 根目录共享配置（团队协作）
!/.vscode/extensions.json
!/.vscode/settings.json
!/.vscode/tasks.json
# 个人配置（仍然忽略，即使在根目录）
/.vscode/launch.json
/.vscode/cmake-kits.json
/.vscode/c_cpp_properties.json
/.vscode/ipch/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.vcxproj.filters
*.vcxproj.user

# Rider / IntelliJ
.idea/
*.iml
*.ipr
*.iws
out/

# Vim / Neovim
*.swp
*.swo
*~
Session.vim

# Sublime Text
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------
# 3. 固件编译输出（RP2350 / CMake / Ninja）
# ------------------------------------------------------------

# 编译输出目录（全目录匹配，不管在哪一层都忽略）
**/build/
**/cmake-build-*/

# CMake 用户本地预设配置（CMake Tools 插件生成，包含个人路径）
CMakeUserPresets.json
cmake-variants.json

# 固件二进制文件
*.elf
*.uf2
*.bin
*.hex
*.map
*.list
*.dis

# CMake 缓存
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.ninja
.ninja_*
compile_commands.json
.vscode/ipch/

# 测试输出
firmware/**/test_results/
firmware/**/coverage/
firmware/**/tests/*.exe
firmware/**/tests/*.o
firmware/**/tests/*.obj

# ------------------------------------------------------------
# 4. 上位机编译输出（.NET / C#）
# ------------------------------------------------------------

# 编译输出
pc_tool/**/bin/
pc_tool/**/obj/
pc_tool/**/out/

# 用户配置
*.user
*.userosscache
*.suo

# NuGet 包
*.nupkg
NuGetPackages/
packages/
!**/packages/build/

# .NET 工具
dotnet-tools.json

# 发布输出
pc_tool/**/publish/
pc_tool/**/Release/
pc_tool/**/Debug/

# ------------------------------------------------------------
# 5. 日志与临时文件
# ------------------------------------------------------------

# 日志文件
*.log
logs/

# 临时文件
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig

# 临时文件夹（存放截图、调试文件等，定期清理）
temp/
tmp/

# 第三方依赖库（自动拉取，不入库）
firmware/lib/*
!firmware/lib/.sdk_version
!firmware/lib/README.md

# 临时文本文件
*.txt
!README*.txt
!LICENSE*.txt
!CHANGELOG*.txt

# ------------------------------------------------------------
# 6. 图片与媒体文件（仅忽略临时截图）
# ------------------------------------------------------------

# 临时截图（命名带 screenshot / 上传等关键词）
*screenshot*
*Screenshot*
*uploaded*
*Uploaded*
*temp*image*
*test*image*

# 例外：项目资源图片（如果有的话）保留
# !**/assets/*.png
# !**/Resources/*.png
# !**/icons/*.ico

# ------------------------------------------------------------
# 7. 压缩包与归档
# ------------------------------------------------------------

*.zip
*.rar
*.7z
*.tar
*.gz
*.bz2

# ------------------------------------------------------------
# 8. 测试与覆盖率
# ------------------------------------------------------------

# 测试结果
TestResults/
*.trx
*.coverage
*.coveragexml

# 覆盖率报告
coverage/
coveragereport/

# ------------------------------------------------------------
# 9. 其他
# ------------------------------------------------------------

# Python 缓存（如果有用到 Python 脚本）
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node.js（如果有用到前端）
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/

# 本地配置文件（敏感信息）
*.local
*.local.json
*.local.config
.env
.env.*
!.env.example

# 调试文件
core.*
*.core
*.dmp
*.mdmp
*.hdmp
