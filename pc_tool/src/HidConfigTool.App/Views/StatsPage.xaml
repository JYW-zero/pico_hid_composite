<UserControl x:Class="HidConfigTool.App.Views.StatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="按键统计"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,24" />

            <!-- 统计概览卡片 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 总按键数 -->
                <Border Grid.Column="0"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="总按键数"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding TotalKeystrokes, StringFormat={}{0:N0}}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryColorBrush}" />
                        <TextBlock Text="累计所有按键次数"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- 今日按键数 -->
                <Border Grid.Column="1"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="12"
                        Padding="20"
                        Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="今日按键数"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding TodayKeystrokes, StringFormat={}{0:N0}}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#9ECE6A" />
                        <TextBlock Text="今天的输入量"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- 平均 KPM -->
                <Border Grid.Column="2"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="12"
                        Padding="20"
                        Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="平均 KPM"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding AverageKpm, StringFormat={}{0:F1}}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#E0AF68" />
                        <TextBlock Text="每分钟按键数"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 时间范围切换 -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="时间范围"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="今日"
                                Command="{Binding SwitchTimeRangeCommand}"
                                CommandParameter="0"
                                Padding="16,8"
                                Margin="0,0,8,0"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Content="本周"
                                Command="{Binding SwitchTimeRangeCommand}"
                                CommandParameter="1"
                                Padding="16,8"
                                Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="本月"
                                Command="{Binding SwitchTimeRangeCommand}"
                                CommandParameter="2"
                                Padding="16,8"
                                Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="全部"
                                Command="{Binding SwitchTimeRangeCommand}"
                                CommandParameter="3"
                                Padding="16,8"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 热力图 -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="按键热力图"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                                Content="重置统计"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ResetStatsCommand}"
                                Padding="16,8" />
                    </Grid>

                    <TextBlock Text="颜色越深表示使用频率越高"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,8,0,16" />

                    <ItemsControl ItemsSource="{Binding HeatmapKeys}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="8" Rows="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding BackgroundBrush}"
                                        CornerRadius="4"
                                        Margin="2"
                                        Padding="8,12">
                                    <ToolTipService.ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="{Binding KeyName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Count, StringFormat=次数: {0:N0}}" />
                                        </StackPanel>
                                    </ToolTipService.ToolTip>
                                    <TextBlock Text="{Binding KeyName}"
                                               FontSize="10"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 最常用按键 Top 10 -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="最常用按键 Top 10"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,16" />

                    <ItemsControl ItemsSource="{Binding TopKeys}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 排名 -->
                                    <Border Grid.Column="0"
                                            Width="28"
                                            Height="28"
                                            CornerRadius="14"
                                            Background="{StaticResource PrimaryColorBrush}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Index}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 键名 -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding KeyName}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- 次数 -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Count, StringFormat={}{0:N0} 次}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />

                                    <!-- 百分比 -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Percentage, StringFormat={}{0:F1}%}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

