<UserControl x:Class="HidConfigTool.App.Views.MacroPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:HidConfigTool.App.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：宏列表 -->
        <Border Grid.Column="0"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="宏列表"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Content="⟳"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshMacrosCommand}"
                            Padding="8,4"
                            FontSize="12"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Macros}"
                         SelectedItem="{Binding CurrentMacro}"
                         Background="Transparent"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderThickness="0"
                         x:Name="MacroListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10"
                                       Background="Transparent">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                               Margin="0,2"
                                                CornerRadius="6">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#24283B" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="保存"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveCurrentMacroCommand}"
                            Padding="16,8"
                            Margin="0,0,8,0"
                            FontSize="12" />
                    <Button Content="新建"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding NewMacroCommand}"
                            Padding="16,8"
                            FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 分隔线 -->
        <GridSplitter Grid.Column="1"
                      Width="1"
                      Background="{StaticResource BorderBrush}"
                      HorizontalAlignment="Center" />

        <!-- 右侧：宏编辑区 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部：宏名称 + 录制 + 循环设置 -->
            <Border Grid.Row="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="20"
                    Margin="8,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="宏名称"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,8" />
                            <TextBox Text="{Binding CurrentMacroName}"
                                     Background="#1A1B26"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="10,8"
                                     Width="300"
                                     HorizontalAlignment="Left">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                                       Padding="{TemplateBinding Padding}"
                                                            CornerRadius="6">
                                                        <ScrollViewer x:Name="PART_ContentHost" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>

                        <Button Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Padding="20,10">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#F7768E" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Content" Value="● 录制" />
                                    <Setter Property="Command" Value="{Binding StartRecordingCommand}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                                               Padding="{TemplateBinding Padding}"
                                                        CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#F56577" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#E55567" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                            <Setter Property="Background" Value="#7AA2F7" />
                                            <Setter Property="Content" Value="■ 停止" />
                                            <Setter Property="Command" Value="{Binding StopRecordingCommand}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <Separator Margin="0,20,0,20" />

                    <!-- 循环设置 -->
                    <TextBlock Text="循环设置"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="循环次数:"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Text="{Binding CurrentMacro.RepeatCount}"
                                 Width="80"
                                 Background="#1A1B26"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"
                                 Padding="8,6"
                                 VerticalAlignment="Center"
                                 Margin="0,0,20,0">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                               Padding="{TemplateBinding Padding}"
                                                        CornerRadius="6">
                                                    <ScrollViewer x:Name="PART_ContentHost" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <CheckBox Content="按住重复，松开停止"
                                  IsChecked="{Binding CurrentMacro.RepeatUntilReleased}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 中间：动作列表 -->
            <Border Grid.Row="1"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="20"
                    Margin="8,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="动作列表"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Actions.Count}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                            <TextBlock Text="个动作"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="2,0,16,0" />
                            <TextBlock Text="总时长:"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalDuration}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0"
                                       FontFamily="Consolas" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="↑"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding MoveUpActionCommand}"
                                    CommandParameter="{Binding SelectedAction}"
                                    Padding="12,6"
                                    Margin="0,0,6,0" />
                            <Button Content="↓"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding MoveDownActionCommand}"
                                    CommandParameter="{Binding SelectedAction}"
                                    Padding="12,6"
                                    Margin="0,0,6,0" />
                            <Button Content="按键"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddKeyActionCommand}"
                                    Padding="12,6"
                                    Margin="0,0,6,0"
                                    FontSize="12" />
                            <Button Content="延时"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding AddDelayActionCommand}"
                                    Padding="12,6"
                                    Margin="0,0,6,0"
                                    FontSize="12" />
                            <Button Content="删除"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding DeleteActionCommand}"
                                    CommandParameter="{Binding SelectedAction}"
                                    Padding="12,6"
                                    FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#1A1B26"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,16,0,0">
                        <ListBox ItemsSource="{Binding Actions}"
                                 SelectedItem="{Binding SelectedAction}"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="0"
                                 AlternationCount="1000">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 序号 -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" />

                                        <!-- 描述 -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Description}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <!-- 类型标签 -->
                                        <Border Grid.Column="2"
                                                Padding="6,2"
                                                CornerRadius="4"
                                                Background="#24283B">
                                            <TextBlock Text="{Binding TypeText}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        Margin="0,1">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#24283B" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#1E2233" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <!-- 底部：动作属性编辑 -->
            <Border Grid.Row="2"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="20"
                    Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="动作属性"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 动作类型 -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="动作类型"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,8" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding SelectedAction.TypeText}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,8" />

                        <!-- 按键名称/延时 -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="参数"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,8" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
                            <TextBox Text="{Binding SelectedAction.KeyName}"
                                     Width="120"
                                     Background="#1A1B26"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="8,6"
                                     Margin="0,0,12,0">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                                   Padding="{TemplateBinding Padding}"
                                                            CornerRadius="6">
                                                        <ScrollViewer x:Name="PART_ContentHost" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBlock Text="延时(ms):"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBox Text="{Binding SelectedAction.DelayMs}"
                                     Width="100"
                                     Background="#1A1B26"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="8,6">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                                   Padding="{TemplateBinding Padding}"
                                                            CornerRadius="6">
                                                        <ScrollViewer x:Name="PART_ContentHost" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>

                        <!-- 键码 -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="按键"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,8" />
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  ItemsSource="{Binding CommonKeys}"
                                  SelectedValuePath="KeyCode"
                                  DisplayMemberPath="Name"
                                  SelectedValue="{Binding SelectedAction.KeyCode}"
                                  Width="200"
                                  Background="#1A1B26"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  BorderThickness="1"
                                  Padding="8,6"
                                  Margin="0,8"
                                  HorizontalAlignment="Left" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
