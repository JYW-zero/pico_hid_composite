<UserControl x:Class="HidConfigTool.App.Views.MacroPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:HidConfigTool.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：宏列表 -->
        <Border Grid.Column="0"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="12"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0"
                           Text="宏列表"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,16" />

                <!-- 宏列表 + 底部工具栏 -->
                <Border Grid.Row="1"
                        Background="{StaticResource InputBackgroundBrush}"
                        CornerRadius="8"
                        Padding="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0"
                                 ItemsSource="{Binding Macros}"
                                 SelectedItem="{Binding CurrentMacro}"
                                 x:Name="MacroListBox"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0"
                                              Data="M13 2L4 14h6l-1 8 9-12h-6l1-8z"
                                              Width="14"
                                              Height="14"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Actions.Count}" Value="0">
                                                            <Setter Property="Fill" Value="{StaticResource TextTertiaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Actions.Count}" Value="0">
                                                            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 底部按钮 -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,8,8,4">
                            <Button Content="清空"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding ClearMacroCommand}"
                                    Padding="12,6"
                                    Margin="0,0,8,0"
                                    FontSize="12" />
                            <Button Content="刷新"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RefreshMacrosCommand}"
                                    Padding="12,6"
                                    FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧：宏编辑区 -->
        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部：宏名称 + 录制 + 循环设置 -->
            <Border Grid.Row="0"
                    Style="{StaticResource CardStyle}"
                    Margin="0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="宏名称"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding CurrentMacroName}"
                                         Width="240"
                                         HorizontalAlignment="Left" />
                                <Button Content="保存"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SaveCurrentMacroCommand}"
                                        Padding="16,8"
                                        Margin="12,0,0,0"
                                        FontSize="12"
                                        VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 录制按钮 -->
                        <Button Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Padding="18,10">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Command" Value="{Binding StartRecordingCommand}" />
                                    <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}"
                                                        CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#FFF56577" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#FFE55567" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Command" Value="{Binding StopRecordingCommand}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Content>
                                <Grid>
                                    <!-- 开始录制 -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0"
                                                 Width="10"
                                                 Height="10"
                                                 Fill="White"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="开始录制" VerticalAlignment="Center" />
                                    </Grid>
                                    <!-- 停止录制 -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0"
                                                   Width="10"
                                                   Height="10"
                                                   Fill="White"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="停止" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Button.Content>
                        </Button>
                    </Grid>

                    <Separator Margin="0,20,0,20" />

                    <!-- 循环设置 -->
                    <TextBlock Text="循环设置"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="循环次数"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   FontSize="13" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding CurrentMacro.RepeatCount}"
                                 VerticalAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentMacro.RepeatUntilReleased}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <CheckBox Grid.Column="3"
                                  Content="按住重复，松开停止"
                                  IsChecked="{Binding CurrentMacro.RepeatUntilReleased}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 中间：动作列表 -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}"
                    Margin="0,16,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标题 + 操作按钮 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="动作列表"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <Border Background="{StaticResource AccentTransparentBrush}"
                                    CornerRadius="10"
                                    Padding="6,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Actions.Count, StringFormat={}{0}/32}"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="总时长:"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="16,0,4,0" />
                            <TextBlock Text="{Binding TotalDuration}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding MoveUpActionCommand}"
                                    CommandParameter="{Binding SelectedAction}"
                                    ToolTip="上移"
                                    Padding="8"
                                    Margin="0,0,4,0">
                                <Path Data="M12 4l8 8h-5v8h-6v-8H4l8-8z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="14"
                                      Height="14" />
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding MoveDownActionCommand}"
                                    CommandParameter="{Binding SelectedAction}"
                                    ToolTip="下移"
                                    Padding="8"
                                    Margin="0,0,8,0">
                                <Path Data="M12 20l-8-8h5V4h6v8h5l-8 8z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="14"
                                      Height="14" />
                            </Button>
                            <Button Content="按键"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddKeyActionCommand}"
                                    Padding="12,7"
                                    Margin="0,0,6,0"
                                    FontSize="12" />
                            <Button Content="延时"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding AddDelayActionCommand}"
                                    Padding="12,7"
                                    Margin="0,0,6,0"
                                    FontSize="12" />
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding DeleteActionCommand}"
                                    CommandParameter="{Binding SelectedAction}"
                                    ToolTip="删除"
                                    Padding="8"
                                    Margin="0,0,4,0">
                                <Path Data="M9 3h6l1 2h4v2H4V5h4l1-2zm-3 6h12l-1 12a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L6 9zm3 2v8h2v-8H9zm4 0v8h2v-8h-2z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="14"
                                      Height="14" />
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding ClearActionsCommand}"
                                    ToolTip="清空所有"
                                    Padding="8">
                                <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="14"
                                      Height="14" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 动作列表 -->
                    <Border Grid.Row="1"
                            Background="{StaticResource InputBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,16,0,0">
                        <ListBox x:Name="ActionListBox"
                                 ItemsSource="{Binding Actions}"
                                 SelectedItem="{Binding SelectedAction}"
                                 MaxHeight="480">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 序号 -->
                                        <Border Grid.Column="0"
                                                Width="22"
                                                Height="22"
                                                Background="{StaticResource CardBackgroundBrush}"
                                                CornerRadius="11"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Index}"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <!-- 描述 -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Description}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0" />

                                        <!-- 类型标签 -->
                                        <Border Grid.Column="2"
                                                Padding="8,3"
                                                CornerRadius="4"
                                                Background="{StaticResource AccentTransparentBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeText}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="10"
                                                       FontWeight="Medium" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <!-- 底部：动作属性编辑 -->
            <Border Grid.Row="2"
                    Style="{StaticResource CardStyle}"
                    Margin="0">
                <StackPanel>
                    <TextBlock Text="动作属性"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 动作类型 -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="动作类型"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,8"
                                   FontSize="13" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding SelectedAction.TypeText}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,8"
                                   FontSize="13" />

                        <!-- 参数 -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="参数"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,8"
                                   FontSize="13" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
                            <TextBox Text="{Binding SelectedAction.KeyName}"
                                     Width="140"
                                     Margin="0,0,16,0" />
                            <TextBlock Text="延时(ms):"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       FontSize="13" />
                            <TextBox Text="{Binding SelectedAction.DelayMs}"
                                     Width="100" />
                        </StackPanel>

                        <!-- 按键选择 -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="按键"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,8"
                                   FontSize="13" />
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  ItemsSource="{Binding CommonKeys}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Name"
                                  SelectedValue="{Binding SelectedAction.KeyName}"
                                  Width="220"
                                  Margin="0,8"
                                  HorizontalAlignment="Left" />
                    </Grid>
                </StackPanel>
            </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
