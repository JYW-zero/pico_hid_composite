<UserControl x:Class="HidConfigTool.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="系统设置"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,24" />

            <!-- 常规设置 -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="常规设置"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,16" />

                    <CheckBox Content="最小化到系统托盘"
                              IsChecked="{Binding MinimizeToTray}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,0,12" />
                    <TextBlock Text="关闭窗口时最小化到托盘，程序继续在后台运行"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="24,0,0,16" />

                    <CheckBox Content="开机自动启动"
                              IsChecked="{Binding AutoStart}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,0,12" />
                    <TextBlock Text="系统启动时自动运行本程序"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="24,0,0,16" />

                    <CheckBox Content="启动时检查更新"
                              IsChecked="{Binding CheckUpdateOnStart}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,0,0" />
                </StackPanel>
            </Border>


            <!-- 配置管理 -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="配置管理"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="导出配置"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ExportConfigCommand}"
                                Padding="20,10"
                                Margin="0,0,12,0" />
                        <Button Content="导入配置"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ImportConfigCommand}"
                                Padding="20,10"
                                Margin="0,0,12,0" />
                        <Button Content="恢复默认"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ResetConfigCommand}"
                                Padding="20,10" />
                    </StackPanel>
                    <TextBlock Text="导出当前配置到 JSON 文件，或从文件导入配置，也可恢复出厂默认配置"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>


            <!-- 配置文件管理 -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="配置文件管理"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="新建"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding NewProfileCommand}"
                                    Padding="12,6"
                                    Margin="0,0,6,0"
                                    FontSize="12" />
                            <Button Content="重命名"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RenameProfileCommand}"
                                    Padding="12,6"
                                    Margin="0,0,6,0"
                                    FontSize="12" />
                            <Button Content="删除"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding DeleteProfileCommand}"
                                    Padding="12,6"
                                    FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="快速切换不同的配置方案"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,8,0,16" />

                    <ListBox ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding CurrentProfile}"
                             Background="#1A1B26"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             Height="150"
                             x:Name="ProfileListBox">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="12,8"
                                                    CornerRadius="4"
                                                    Margin="2">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryColorBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#24283B" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- 应用感知 -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="应用感知"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                                Content="添加规则"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AddAppRuleCommand}"
                                Padding="12,6"
                                FontSize="12" />
                    </Grid>

                    <TextBlock Text="自动检测前台应用，切换对应配置方案"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,8,0,16" />

                    <!-- 总开关 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="启用应用感知"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="开启后自动根据当前应用切换配置"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding AppAwarenessEnabled}"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <!-- 当前前台应用 -->
                    <Border Background="#1A1B26"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="当前前台："
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentForegroundApp}"
                                       Foreground="{StaticResource PrimaryColorBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- 规则列表 -->
                    <ItemsControl ItemsSource="{Binding AppAwarenessRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A1B26"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 启用开关 -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsEnabled}"
                                                  VerticalAlignment="Center" />

                                        <!-- 应用信息 -->
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AppName}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="13" />
                                            <TextBlock Text="{Binding ProcessName}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" />
                                        </StackPanel>

                                        <!-- 对应配置 -->
                                        <Border Grid.Column="2"
                                                Background="{StaticResource PrimaryColorBrush}"
                                                CornerRadius="4"
                                                Padding="8,4"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="{Binding ProfileName}"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </Border>

                                        <!-- 删除按钮 -->
                                        <Button Grid.Column="3"
                                                Content="删除"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.RemoveAppRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="10,4"
                                                FontSize="11"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- 固件升级 -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="固件升级"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="当前版本" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,8" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentFirmwareVersion}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,8" />
                        <Button Grid.Row="0" Grid.Column="2"
                                Content="检查更新"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CheckUpdateCommand}"
                                Padding="16,8"
                                IsEnabled="{Binding IsUpdating, Converter={StaticResource InvertBoolConverter}}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="最新版本" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,8" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatestFirmwareVersion}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,8" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding FirmwareFilePath}"
                                 IsReadOnly="True"
                                 Background="#1A1B26"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"
                                 Padding="10,8"
                                 VerticalAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ScrollViewer x:Name="PART_ContentHost" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Button Grid.Column="1"
                                Content="选择文件"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SelectFirmwareFileCommand}"
                                Padding="16,8"
                                Margin="12,0,0,0"
                                IsEnabled="{Binding IsUpdating, Converter={StaticResource InvertBoolConverter}}" />
                    </Grid>

                    <!-- 进度条 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ProgressBar Grid.Column="0"
                                     Value="{Binding UpdateProgress}"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="8"
                                     Foreground="{StaticResource PrimaryColorBrush}"
                                     Background="#1A1B26"
                                     VerticalAlignment="Center"
                                     Margin="0,0,12,0" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding UpdateProgress, StringFormat={}{0:0}%}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding UpdateStatus}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,12" />

                    <Button Content="开始升级"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding StartUpdateCommand}"
                            Padding="20,10"
                            HorizontalAlignment="Right"
                            IsEnabled="{Binding IsUpdating, Converter={StaticResource InvertBoolConverter}}" />
                </StackPanel>
            </Border>
            <!-- 外观设置 -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="外观设置"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,16" />

                    <TextBlock Text="主题"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,8" />
                    <ComboBox Width="200"
                              Margin="0,0,0,16">
                        <ComboBoxItem Content="深色" IsSelected="True" />
                        <ComboBoxItem Content="浅色" />
                        <ComboBoxItem Content="跟随系统" />
                    </ComboBox>

                    <TextBlock Text="语言"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,8" />
                    <ComboBox Width="200">
                        <ComboBoxItem Content="简体中文" IsSelected="True" />
                        <ComboBoxItem Content="English" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="关于"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="版本" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="v0.1.0" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="开发" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="HID 配置工具团队" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="技术栈" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="WPF + .NET 10" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>





