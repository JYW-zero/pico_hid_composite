<UserControl x:Class="HidConfigTool.App.Views.JoystickPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
        <StackPanel>
            <TextBlock Text="摇杆设置"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,24" />

        <!-- 死区设置卡片 -->
        <Border Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="死区设置"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,16" />

                <TextBlock Text="死区大小"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,8" />
                <Slider Value="{Binding Deadzone}"
                        Minimum="0"
                        Maximum="500"
                        TickFrequency="10"
                        Margin="0,0,0,8" />
                <TextBlock Text="{Binding Deadzone, StringFormat=当前值: {0}}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- 灵敏度设置卡片 -->
        <Border Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,16"
                Opacity="0.5">
            <StackPanel IsEnabled="False">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="灵敏度"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="（开发中）"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock Text="灵敏度倍率"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,8" />
                <Slider Value="{Binding Sensitivity}"
                        Minimum="0.5"
                        Maximum="2.0"
                        TickFrequency="0.1"
                        Margin="0,0,0,8" />
                <TextBlock Text="{Binding Sensitivity, StringFormat=当前值: {0:0.0}x}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- 方向设置卡片 -->
        <Border Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="12"
                Padding="20"
                Opacity="0.5">
            <StackPanel IsEnabled="False">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="方向设置"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="（开发中）"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>

                <CheckBox Content="反转 X 轴"
                          IsChecked="{Binding InvertX}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Margin="0,0,0,12" />
                <CheckBox Content="反转 Y 轴"
                          IsChecked="{Binding InvertY}"
                          Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
