<UserControl x:Class="HidConfigTool.App.Views.PerfMonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:HidConfigTool.App.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：标题 + 控制 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="性能监控"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <Ellipse Width="8"
                         Height="8"
                         Fill="#7AA2F7"
                         Margin="12,0,0,0"
                         VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AutoRefresh}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="自动刷新"
                          IsChecked="{Binding AutoRefresh}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0" />

                <TextBlock Text="间隔:"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox Text="{Binding RefreshInterval}"
                         Width="60"
                         Background="#1A1B26"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"
                         Padding="6,4"
                         VerticalAlignment="Center"
                         Margin="0,0,4,0">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                       Padding="{TemplateBinding Padding}"
                                                CornerRadius="4">
                                            <ScrollViewer x:Name="PART_ContentHost" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock Text="秒"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />

                <Button Content="刷新"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsDeviceConnected}"
                        Padding="16,8"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Content" Value="加载中..." />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="重置"
                        Command="{Binding ResetCommand}"
                        IsEnabled="{Binding IsDeviceConnected}"
                        Padding="16,8"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 统计卡片 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CPU使用率 -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="20,16">
                <StackPanel>
                    <TextBlock Text="CPU 使用率"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding CpuUsageText, Mode=OneWay}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#7AA2F7"
                                   VerticalAlignment="Bottom" />
                        <TextBlock Grid.Column="1"
                                   Text="%"
                                   FontSize="16"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="4,0,0,6" />
                    </Grid>
                    <!-- 进度条（简化版） -->
                    <Border Background="#1A1B26"
                            CornerRadius="4"
                            Height="6"
                            Margin="0,12,0,0">
                        <Border x:Name="CpuProgressBar"
                                Background="#7AA2F7"
                                CornerRadius="4"
                                HorizontalAlignment="Left"
                                Width="0" />
                    </Border>
                    <TextBlock FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Margin="0,8,0,0">
                        <Run Text="10s: " />
                        <Run Text="{Binding CpuAvg10sText, Mode=OneWay}" />
                        <Run Text="%  |  30s: " />
                        <Run Text="{Binding CpuAvg30sText, Mode=OneWay}" />
                        <Run Text="%" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 循环频率 -->
            <Border Grid.Column="2"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="20,16">
                <StackPanel>
                    <TextBlock Text="主循环频率"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding LoopFreqText, Mode=OneWay}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#9ECE6A"
                                   VerticalAlignment="Bottom" />
                        <TextBlock Grid.Column="1"
                                   Text="Hz"
                                   FontSize="16"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="4,0,0,6" />
                    </Grid>
                    <TextBlock FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Margin="0,12,0,0">
                        <Run Text="每秒循环次数  |  10s平均: " />
                        <Run Text="{Binding LoopFreqAvg10sText, Mode=OneWay}" />
                        <Run Text=" Hz" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 运行时间 -->
            <Border Grid.Column="4"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="20,16">
                <StackPanel>
                    <TextBlock Text="运行时间"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,12" />
                    <TextBlock Text="{Binding UptimeText, Mode=OneWay}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#E0AF68"
                               FontFamily="Consolas" />
                    <TextBlock Text="设备启动后累计运行"
                               FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- 任务数量 -->
            <Border Grid.Column="6"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="20,16">
                <StackPanel>
                    <TextBlock Text="监控任务"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding TaskCountText, Mode=OneWay}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#BB9AF7"
                                   VerticalAlignment="Bottom" />
                        <TextBlock Grid.Column="1"
                                   Text="个"
                                   FontSize="16"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="4,0,0,6" />
                    </Grid>
                    <TextBlock Text="已注册的监控任务"
                               FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- CPU使用率折线图 -->
        <Border Grid.Row="4"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="12"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="120" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="CPU 使用率趋势"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <!-- 图表区域 -->
                <Grid Grid.Row="2">
                    <!-- 背景网格线 -->
                    <Canvas Background="#1A1B26"
                            Width="400"
                            Height="120"
                            HorizontalAlignment="Left">
                        <!-- 0% 线 -->
                        <Line X1="0" Y1="120" X2="400" Y2="120"
                              Stroke="#2A2B3D" StrokeThickness="1" />
                        <!-- 25% 线 -->
                        <Line X1="0" Y1="90" X2="400" Y2="90"
                              Stroke="#2A2B3D" StrokeThickness="1" />
                        <!-- 50% 线 -->
                        <Line X1="0" Y1="60" X2="400" Y2="60"
                              Stroke="#2A2B3D" StrokeThickness="1" />
                        <!-- 75% 线 -->
                        <Line X1="0" Y1="30" X2="400" Y2="30"
                              Stroke="#2A2B3D" StrokeThickness="1" />
                        <!-- 100% 线 -->
                        <Line X1="0" Y1="0" X2="400" Y2="0"
                              Stroke="#2A2B3D" StrokeThickness="1" />

                        <!-- CPU折线 -->
                        <Polyline Points="{Binding CpuChartPoints}"
                                  Stroke="#4FC3F7"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                    </Canvas>

                    <!-- Y轴标签 -->
                    <StackPanel HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="-30,0,0,0">
                        <TextBlock Text="100%" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Height="20" />
                        <TextBlock Text="75%" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Height="30" />
                        <TextBlock Text="50%" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Height="30" />
                        <TextBlock Text="25%" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Height="30" />
                        <TextBlock Text="0%" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Height="10" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 底部：任务详情 -->
        <Border Grid.Row="6"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="12"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="任务详情"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,16" />

                <Border Grid.Row="1"
                        Background="#1A1B26"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <ListView ItemsSource="{Binding TaskStats}"
                              Background="Transparent"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="任务名称"
                                                Width="120"
                                                DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="执行次数"
                                                Width="80"
                                                DisplayMemberBinding="{Binding ExecutionCount}" />
                                <GridViewColumn Header="CPU占比"
                                                Width="70"
                                                DisplayMemberBinding="{Binding CpuPercent, StringFormat={}{0}%}" />
                                <GridViewColumn Header="最小(us)"
                                                Width="70"
                                                DisplayMemberBinding="{Binding MinTimeUs}" />
                                <GridViewColumn Header="最大(us)"
                                                Width="70"
                                                DisplayMemberBinding="{Binding MaxTimeUs}" />
                                <GridViewColumn Header="平均(us)"
                                                Width="70"
                                                DisplayMemberBinding="{Binding AvgTimeUs}" />
                                <GridViewColumn Header="最近(us)"
                                                Width="70"
                                                DisplayMemberBinding="{Binding LastTimeUs}" />
                                <GridViewColumn Header="超时次数"
                                                Width="70"
                                                DisplayMemberBinding="{Binding OverrunCount}" />
                            </GridView>
                        </ListView.View>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="Padding" Value="8,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
