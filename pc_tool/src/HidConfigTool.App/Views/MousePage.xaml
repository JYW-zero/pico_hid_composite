<UserControl x:Class="HidConfigTool.App.Views.MousePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
        <StackPanel>
            <TextBlock Text="鼠标设置"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,24" />

        <!-- DPI 设置卡片 -->
        <Border Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="DPI 档位"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,16" />

                <TextBlock Text="{Binding CurrentDpiText}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           Margin="0,0,0,16" />

                <StackPanel Orientation="Horizontal">
                    <Button Content="400" Command="{Binding SetDpiCommand}" CommandParameter="0" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DpiButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentDpiIndex}" Value="0">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="800" Command="{Binding SetDpiCommand}" CommandParameter="1" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DpiButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentDpiIndex}" Value="1">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="1600" Command="{Binding SetDpiCommand}" CommandParameter="2" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DpiButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentDpiIndex}" Value="2">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="3200" Command="{Binding SetDpiCommand}" CommandParameter="3">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DpiButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentDpiIndex}" Value="3">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 指针加速卡片 -->
        <Border Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="12"
                Padding="20">
            <StackPanel>
                <TextBlock Text="指针加速"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,16" />

                <CheckBox Content="启用指针加速"
                          IsChecked="{Binding AccelerationEnabled}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Margin="0,0,0,16" />

                <TextBlock Text="加速阈值"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,8" />
                <Slider Value="{Binding AccelerationThreshold}"
                        Minimum="0"
                        Maximum="50"
                        IsEnabled="{Binding AccelerationEnabled}"
                        Margin="0,0,0,16" />

                <TextBlock Text="加速比"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,8" />
                <Slider Value="{Binding AccelerationRatio}"
                        Minimum="1"
                        Maximum="3"
                        TickFrequency="0.1"
                        IsEnabled="{Binding AccelerationEnabled}" />
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>


