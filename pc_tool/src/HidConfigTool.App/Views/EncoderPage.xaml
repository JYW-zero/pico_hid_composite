<UserControl x:Class="HidConfigTool.App.Views.EncoderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
        <StackPanel>
            <TextBlock Text="编码器设置"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,24" />

        <!-- 方向设置卡片 -->
        <Border Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="方向设置"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,16" />

                <CheckBox Content="反转滚轮方向"
                          IsChecked="{Binding ReverseDirection}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Margin="0,0,0,8" />
                <TextBlock Text="开启后，向上滚动变为向下滚动，反之亦然"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- 步长设置卡片 -->
        <Border Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,16"
                Opacity="0.5">
            <StackPanel IsEnabled="False">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="步长设置"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="（开发中）"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock Text="每格步数"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,8" />
                <Slider Value="{Binding StepsPerTick}"
                        Minimum="1"
                        Maximum="10"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Margin="0,0,0,8" />
                <TextBlock Text="{Binding StepsPerTick, StringFormat=当前值: {0} 步/格}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- 滚动速度卡片 -->
        <Border Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="12"
                Padding="20"
                Opacity="0.5">
            <StackPanel IsEnabled="False">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="滚动速度"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="（开发中）"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock Text="滚动速度倍率"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,8" />
                <Slider Value="{Binding ScrollSpeed}"
                        Minimum="1"
                        Maximum="10"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Margin="0,0,0,8" />
                <TextBlock Text="{Binding ScrollSpeed, StringFormat=当前值: {0}x}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
