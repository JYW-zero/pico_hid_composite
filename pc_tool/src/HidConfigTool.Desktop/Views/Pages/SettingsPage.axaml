<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HidConfigTool.Desktop.ViewModels"
             x:Class="HidConfigTool.Desktop.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">
  <StackPanel Spacing="16">
    <TextBlock Text="设置" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
    <Border Background="{DynamicResource CardBg}" CornerRadius="8" Padding="16">
      <StackPanel Spacing="10">
        <TextBlock Text="导出配置到文件" Foreground="{DynamicResource TextPrimary}" />
        <TextBox Watermark="/tmp/config.bin" Text="{Binding ExportPath}" />
        <Button Content="导出" Command="{Binding ExportCommand}" HorizontalAlignment="Left" />
        <TextBlock Text="从文件导入配置" Foreground="{DynamicResource TextPrimary}" Margin="0,12,0,0" />
        <TextBox Watermark="/tmp/config.bin" Text="{Binding ImportPath}" />
        <Button Content="导入并写入设备" Command="{Binding ImportCommand}" HorizontalAlignment="Left" />
        <Button Content="恢复设备默认配置" Command="{Binding ResetCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondary}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
