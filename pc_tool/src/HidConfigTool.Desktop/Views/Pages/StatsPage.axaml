<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HidConfigTool.Desktop.ViewModels"
             x:Class="HidConfigTool.Desktop.Views.Pages.StatsPage"
             x:DataType="vm:StatsPageViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="10">
      <TextBlock Text="按键统计" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
      <TextBlock Text="{Binding TotalKeystrokes, StringFormat='总按键: {0}'}" Foreground="{DynamicResource Accent}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="刷新" Command="{Binding RefreshCommand}" />
        <Button Content="清零" Command="{Binding ResetCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondary}" />
    </StackPanel>
    <ListBox ItemsSource="{Binding Items}" Margin="0,12,0,0">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:KeyStatItemViewModel">
          <Grid ColumnDefinitions="60,*,80">
            <TextBlock Text="{Binding Index}" />
            <TextBlock Grid.Column="1" Text="{Binding KeyName}" />
            <TextBlock Grid.Column="2" Text="{Binding Count}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
