<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HidConfigTool.Desktop.ViewModels"
             x:Class="HidConfigTool.Desktop.Views.Pages.JoystickPage"
             x:DataType="vm:JoystickPageViewModel">
  <StackPanel Spacing="16">
    <TextBlock Text="摇杆" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
    <Border Background="{DynamicResource CardBg}" CornerRadius="8" Padding="16">
      <StackPanel Spacing="10">
        <TextBlock Text="{Binding Deadzone, StringFormat='死区: {0:0}'}" Foreground="{DynamicResource TextPrimary}" />
        <Slider Minimum="0" Maximum="800" Value="{Binding Deadzone}" />
        <TextBlock Text="{Binding Sensitivity, StringFormat='灵敏度: {0:0.00}'}" Foreground="{DynamicResource TextPrimary}" />
        <Slider Minimum="0.2" Maximum="3" Value="{Binding Sensitivity}" />
        <CheckBox Content="X 轴反转" IsChecked="{Binding InvertX}" />
        <CheckBox Content="Y 轴反转" IsChecked="{Binding InvertY}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
