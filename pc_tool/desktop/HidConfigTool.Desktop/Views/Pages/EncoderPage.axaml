<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HidConfigTool.ViewModels"
             x:Class="HidConfigTool.Desktop.Views.Pages.EncoderPage"
             x:DataType="vm:EncoderPageViewModel">
  <StackPanel Spacing="16">
    <TextBlock Text="编码器" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
    <Border Background="{DynamicResource CardBg}" CornerRadius="8" Padding="16">
      <StackPanel Spacing="10">
        <CheckBox Content="反转方向" IsChecked="{Binding ReverseDirection}" />
        <TextBlock Text="每格步数" Foreground="{DynamicResource TextPrimary}" />
        <NumericUpDown Minimum="1" Maximum="8" Increment="1" Value="{Binding StepsPerTick}" Width="120" HorizontalAlignment="Left" />
        <TextBlock Text="滚轮速度" Foreground="{DynamicResource TextPrimary}" />
        <NumericUpDown Minimum="1" Maximum="10" Increment="1" Value="{Binding ScrollSpeed}" Width="120" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
