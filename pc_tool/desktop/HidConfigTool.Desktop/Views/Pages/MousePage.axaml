<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HidConfigTool.ViewModels"
             x:Class="HidConfigTool.Desktop.Views.Pages.MousePage"
             x:DataType="vm:MousePageViewModel">
  <StackPanel Spacing="16">
    <TextBlock Text="鼠标" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
    <Border Background="{DynamicResource CardBg}" CornerRadius="8" Padding="16">
      <StackPanel Spacing="10">
        <TextBlock Text="{Binding CurrentDpiText}" FontSize="18" Foreground="{DynamicResource Accent}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="400" Command="{Binding SetDpiCommand}" CommandParameter="0" />
          <Button Content="800" Command="{Binding SetDpiCommand}" CommandParameter="1" />
          <Button Content="1600" Command="{Binding SetDpiCommand}" CommandParameter="2" />
          <Button Content="3200" Command="{Binding SetDpiCommand}" CommandParameter="3" />
        </StackPanel>
        <CheckBox Content="指针加速" IsChecked="{Binding AccelerationEnabled}" />
        <TextBlock Text="加速阈值" Foreground="{DynamicResource TextSecondary}" />
        <Slider Minimum="1" Maximum="50" Value="{Binding AccelerationThreshold}" />
        <TextBlock Text="加速比" Foreground="{DynamicResource TextSecondary}" />
        <Slider Minimum="1" Maximum="5" Value="{Binding AccelerationRatio}" />
        <TextBlock Text="{Binding IsApplying, StringFormat='状态: {0}'}" Foreground="#888888" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
