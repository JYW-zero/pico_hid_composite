<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HidConfigTool.ViewModels"
             xmlns:models="using:HidConfigTool.Core.Models"
             x:Class="HidConfigTool.Desktop.Views.Pages.MacroPage"
             x:DataType="vm:MacroPageViewModel">
  <Grid ColumnDefinitions="220,*" ColumnSpacing="16">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="宏" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
        <Button Content="新建" Command="{Binding NewMacroCommand}" />
        <Button Content="刷新" Command="{Binding RefreshMacrosCommand}" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Macros}" SelectedItem="{Binding CurrentMacro}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="models:Macro">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <StackPanel Grid.Column="1" Spacing="10">
      <TextBox Watermark="宏名称" Text="{Binding CurrentMacroName}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="添加按键" Command="{Binding AddKeyActionCommand}" />
        <Button Content="添加延迟" Command="{Binding AddDelayActionCommand}" />
        <Button Content="删除选中" Command="{Binding DeleteActionCommand}" CommandParameter="{Binding SelectedAction}" />
        <Button Content="保存" Command="{Binding SaveCurrentMacroCommand}" />
        <Button Content="播放" Command="{Binding PlayMacroCommand}" />
        <Button Content="停止" Command="{Binding StopPlaybackCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding StatusMessage}" Foreground="#888888" />
      <ListBox ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" Height="360">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:MacroActionItemViewModel">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding Index}" Width="24" />
              <TextBlock Text="{Binding TypeText}" Width="80" />
              <TextBlock Text="{Binding Description}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
  </Grid>
</UserControl>
