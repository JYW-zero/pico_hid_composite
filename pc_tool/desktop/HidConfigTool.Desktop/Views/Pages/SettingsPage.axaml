<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HidConfigTool.ViewModels"
             x:Class="HidConfigTool.Desktop.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">
  <StackPanel Spacing="16">
    <TextBlock Text="设置" FontSize="22" FontWeight="Bold" />
    <Border Background="#2D2D30" CornerRadius="8" Padding="16">
      <StackPanel Spacing="10">
        <TextBlock Text="配置管理" FontWeight="Bold" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="导出配置" Command="{Binding ExportConfigCommand}" />
          <Button Content="导入配置" Command="{Binding ImportConfigCommand}" />
          <Button Content="恢复默认" Command="{Binding ResetConfigCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}" Foreground="#888888" />
      </StackPanel>
    </Border>
    <Border Background="#2D2D30" CornerRadius="8" Padding="16">
      <StackPanel Spacing="10">
        <TextBlock Text="通用设置" FontWeight="Bold" />
        <CheckBox Content="最小化到托盘" IsChecked="{Binding MinimizeToTray}" />
        <CheckBox Content="开机自启动" IsChecked="{Binding AutoStart}" />
        <CheckBox Content="OSD 提示" IsChecked="{Binding OsdEnabled}" />
        <CheckBox Content="应用感知" IsChecked="{Binding AppAwarenessEnabled}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
