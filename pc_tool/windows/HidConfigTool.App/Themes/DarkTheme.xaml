<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:conv="clr-namespace:HidConfigTool.App.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Icons.xaml" />
        <ResourceDictionary Source="BaseTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ==================== 颜色定义 ==================== -->
    <!-- 主背景 -->
    <Color x:Key="BackgroundColor">#FF1A1B26</Color>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />

    <!-- 标题栏 -->
    <Color x:Key="TitleBarColor">#FF13131A</Color>
    <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarColor}" />

    <!-- 侧边栏 -->
    <Color x:Key="SidebarColor">#FF16161E</Color>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />

    <!-- 内容区背景 -->
    <Color x:Key="ContentBackgroundColor">#FF1A1B26</Color>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{StaticResource ContentBackgroundColor}" />

    <!-- 卡片背景 -->
    <Color x:Key="CardBackgroundColor">#FF24283B</Color>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />

    <!-- 卡片悬浮背景 -->
    <Color x:Key="CardHoverColor">#FF2A2E42</Color>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />

    <!-- 输入框背景 -->
    <Color x:Key="InputBackgroundColor">#FF1A1B26</Color>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />

    <!-- 边框 -->
    <Color x:Key="BorderColor">#FF2E3347</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <!-- 主色调（蓝色） -->
    <Color x:Key="AccentColor">#FF7AA2F7</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

    <!-- 主色调悬停 -->
    <Color x:Key="AccentHoverColor">#FF89B4FA</Color>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />

    <!-- 主色调按下 -->
    <Color x:Key="AccentPressedColor">#FF6C8FE8</Color>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />

    <!-- 主色调半透明 -->
    <Color x:Key="AccentTransparentColor">#337AA2F7</Color>
    <SolidColorBrush x:Key="AccentTransparentBrush" Color="{StaticResource AccentTransparentColor}" />

    <!-- Primary 别名（兼容页面里的命名） -->
    <SolidColorBrush x:Key="PrimaryColorBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource AccentPressedColor}" />

    <!-- 成功色（绿色） -->
    <Color x:Key="SuccessColor">#FF9ECE6A</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

    <!-- 错误色（红色） -->
    <Color x:Key="ErrorColor">#FFF7768E</Color>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

    <!-- 警告色（黄色） -->
    <Color x:Key="WarningColor">#FFE0AF68</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <!-- 信息色（青色） -->
    <Color x:Key="InfoColor">#FF7DCFFF</Color>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

    <!-- 主要文字 -->
    <Color x:Key="TextPrimaryColor">#FFC0CAF5</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />

    <!-- 次要文字 -->
    <Color x:Key="TextSecondaryColor">#FF9AA5CE</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

    <!-- 三级文字 -->
    <Color x:Key="TextTertiaryColor">#FF7A84A8</Color>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />

    <!-- 禁用文字 -->
    <Color x:Key="TextDisabledColor">#FF565F89</Color>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

    <!-- 悬停背景 -->
    <Color x:Key="HoverBackgroundColor">#FF2E3347</Color>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}" />

    <!-- 选中背景 -->
    <Color x:Key="SelectedBackgroundColor">#FF3D4363</Color>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="{StaticResource SelectedBackgroundColor}" />

    <!-- ==================== 页面基础样式 ==================== -->
    <!-- 隐式样式：所有 UserControl 自动继承不透明背景，防止页面切换时旧内容透出 -->
    <Style TargetType="UserControl">
        <Setter Property="Background" Value="{StaticResource ContentBackgroundBrush}" />
    </Style>

    <!-- ==================== 阴影效果 ==================== -->
    <DropShadowEffect x:Key="CardShadowEffect"
                      Color="#000000"
                      BlurRadius="16"
                      ShadowDepth="0"
                      Opacity="0.3" />

    <DropShadowEffect x:Key="PopupShadowEffect"
                      Color="#000000"
                      BlurRadius="24"
                      ShadowDepth="0"
                      Opacity="0.5" />

    <DropShadowEffect x:Key="AccentGlowEffect"
                      Color="#FF7AA2F7"
                      BlurRadius="12"
                      ShadowDepth="0"
                      Opacity="0.4" />

    <!-- ==================== 转换器 ==================== -->
    <conv:BoolToColorConverter x:Key="BoolToColorConverter" />
    <conv:InvertBoolConverter x:Key="InvertBoolConverter" />
    <conv:NullToBoolConverter x:Key="NullToBoolConverter" />
    <conv:BoolToVisConverter x:Key="BoolToVisConverter" />
    <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
    <conv:BoolToStatusConverter x:Key="BoolToStatusConverter" />
    <conv:BoolToBuiltInConverter x:Key="BoolToBuiltInConverter" />
    <conv:BoolToVisConverterInverse x:Key="BoolToVisConverterInverse" />

</ResourceDictionary>
