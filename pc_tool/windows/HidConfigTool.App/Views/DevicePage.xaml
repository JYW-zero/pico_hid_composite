<UserControl x:Class="HidConfigTool.App.Views.DevicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel>
            <!-- 页面标题 -->
            <TextBlock Text="设备管理" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="管理已连接的 HID 复合设备" Style="{StaticResource PageSubtitleStyle}" />

            <!-- 设备列表卡片 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <!-- 卡片标题 + 刷新按钮 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="已连接设备"
                                   Style="{StaticResource CardTitleStyle}"
                                   Margin="0"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                ToolTip="刷新设备列表"
                                Padding="8">
                            <Path Data="M12 5V2L7 7l5 5V8a5 5 0 1 1-5 5H5a7 7 0 1 0 7-8z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="16"
                                  Height="16" />
                        </Button>
                    </Grid>

                    <!-- 设备列表 -->
                    <Border Background="{StaticResource InputBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4">
                        <ListBox ItemsSource="{Binding Devices}"
                                 SelectedItem="{Binding SelectedDevice}"
                                 Height="160">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 设备图标 -->
                                        <Border Grid.Column="0"
                                                Width="36"
                                                Height="36"
                                                Background="{StaticResource AccentTransparentBrush}"
                                                CornerRadius="8"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0">
                                            <Path Data="M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm0 2v10h16V6H4zm4 14h8v2H8v-2z"
                                                  Fill="{StaticResource AccentBrush}"
                                                  Width="20"
                                                  Height="20"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>

                                        <!-- 设备信息 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProductName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="VID:"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding VendorIdHex}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontFamily="Consolas"
                                                           Margin="0,0,12,0" />
                                                <TextBlock Text="PID:"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding ProductIdHex}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontFamily="Consolas" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 设备信息卡片 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="设备信息" Style="{StaticResource CardTitleStyle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="设备名称" Style="{StaticResource LabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DeviceName}" Style="{StaticResource ValueStyle}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="固件版本" Style="{StaticResource LabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FirmwareVersion}" Style="{StaticResource ValueStyle}" FontFamily="Consolas" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="连接状态" Style="{StaticResource LabelStyle}" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="未连接" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Text" Value="已连接" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="状态消息" Style="{StaticResource LabelStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StatusMessage}" Style="{StaticResource ValueStyle}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 设备操作卡片 -->
            <Border Style="{StaticResource CardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="设备操作" Style="{StaticResource CardTitleStyle}" />

                    <StackPanel Orientation="Horizontal">
                        <!-- 重启设备 -->
                        <Button Command="{Binding RebootCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 5V2L7 7l5 5V8a5 5 0 1 1-5 5H5a7 7 0 1 0 7-8z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="14"
                                      Height="14"
                                      Margin="0,0,8,0" />
                                <TextBlock Text="重启设备" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- 进入烧录模式 -->
                        <Button Command="{Binding EnterBootselCommand}"
                                Style="{StaticResource PrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M9 3h6v2h3a2 2 0 0 1 2 2v3h2v2h-2v2h2v2h-2v3a2 2 0 0 1-2 2h-3v2H9v-2H6a2 2 0 0 1-2-2v-3H2v-2h2v-2H2V9h2V6a2 2 0 0 1 2-2h3V2zm0 4v10h6V7H9z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="14"
                                      Height="14"
                                      Margin="0,0,8,0" />
                                <TextBlock Text="进入烧录模式" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="提示：进入烧录模式后，设备将以 USB 大容量存储设备形式出现，可将固件文件拖入完成升级。"
                               Style="{StaticResource HintStyle}"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
