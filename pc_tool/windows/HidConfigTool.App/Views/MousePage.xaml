<UserControl x:Class="HidConfigTool.App.Views.MousePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:HidConfigTool.App.Localization"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel>
            <!-- 页面标题 -->
            <TextBlock Text="{Binding [Title_MouseSettings], Source={StaticResource LocalizationService}}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{Binding [Subtitle_MouseSettings], Source={StaticResource LocalizationService}}" Style="{StaticResource PageSubtitleStyle}" />

            <!-- DPI 设置卡片 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding [Label_DpiPresets], Source={StaticResource LocalizationService}}" Style="{StaticResource CardTitleStyle}" />

                    <!-- 大号 DPI 显示 -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentDpiText}"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding [Label_CurrentDpi], Source={StaticResource LocalizationService}}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Border Background="{StaticResource AccentTransparentBrush}"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    Margin="0,0,8,0">
                                <TextBlock Text="{Binding [Label_SupportCustom], Source={StaticResource LocalizationService}}"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Medium" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- DPI 档位按钮 -->
                    <UniformGrid Columns="4">
                        <Button Content="400" Command="{Binding SetDpiCommand}" CommandParameter="0" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DpiButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentDpiIndex}" Value="0">
                                            <Setter Property="Tag" Value="Active" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="800" Command="{Binding SetDpiCommand}" CommandParameter="1" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DpiButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentDpiIndex}" Value="1">
                                            <Setter Property="Tag" Value="Active" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="1600" Command="{Binding SetDpiCommand}" CommandParameter="2" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DpiButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentDpiIndex}" Value="2">
                                            <Setter Property="Tag" Value="Active" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="3200" Command="{Binding SetDpiCommand}" CommandParameter="3">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DpiButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentDpiIndex}" Value="3">
                                            <Setter Property="Tag" Value="Active" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>

                    <!-- 自定义 DPI 滑块 -->
                    <StackPanel Margin="0,16,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding [Label_CustomDpi], Source={StaticResource LocalizationService}}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    Background="{StaticResource InputBackgroundBrush}"
                                    CornerRadius="4"
                                    Padding="8,4">
                                <TextBlock Text="{Binding CurrentDpi, StringFormat={}{0:F0}}"
                                           FontSize="12"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontFamily="Consolas"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <Slider Value="{Binding CurrentDpi}"
                                Minimum="100"
                                Maximum="6400"
                                TickFrequency="100"
                                IsSnapToTickEnabled="False" />
                        <TextBlock Text="{Binding [Hint_CustomDpi], Source={StaticResource LocalizationService}}"
                                   Style="{StaticResource HintStyle}"
                                   Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- DPI 切换按钮 -->
                    <Button Content="{Binding [Btn_SwitchDpi], Source={StaticResource LocalizationService}}"
                            Command="{Binding SwitchDpiSlotCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <!-- 高级设置卡片 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding [Label_AdvancedSettings], Source={StaticResource LocalizationService}}" Style="{StaticResource CardTitleStyle}" />

                    <!-- 4档 DPI 值配置 -->
                    <TextBlock Text="{Binding [Label_DpiPresetConfig], Source={StaticResource LocalizationService}}"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{Binding [Label_Preset1], Source={StaticResource LocalizationService}}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding DpiSlot0}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="{Binding [Label_Preset2], Source={StaticResource LocalizationService}}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding DpiSlot1}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="{Binding [Label_Preset3], Source={StaticResource LocalizationService}}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding DpiSlot2}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="{Binding [Label_Preset4], Source={StaticResource LocalizationService}}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding DpiSlot3}" />
                        </StackPanel>
                    </Grid>

                    <!-- 当前 DPI 档位选择 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding [Label_CurrentDpiPreset], Source={StaticResource LocalizationService}}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  SelectedIndex="{Binding CurrentDpiSlot}"
                                  Width="120">
                            <ComboBoxItem Content="{Binding [Label_Preset1], Source={StaticResource LocalizationService}}" />
                            <ComboBoxItem Content="{Binding [Label_Preset2], Source={StaticResource LocalizationService}}" />
                            <ComboBoxItem Content="{Binding [Label_Preset3], Source={StaticResource LocalizationService}}" />
                            <ComboBoxItem Content="{Binding [Label_Preset4], Source={StaticResource LocalizationService}}" />
                        </ComboBox>
                    </Grid>

                    <!-- LOD 静默高度 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding [Label_Lod], Source={StaticResource LocalizationService}}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  SelectedIndex="{Binding LodLevel}"
                                  Width="120">
                            <ComboBoxItem Content="{Binding [Lod_Low], Source={StaticResource LocalizationService}}" />
                            <ComboBoxItem Content="{Binding [Lod_Medium], Source={StaticResource LocalizationService}}" />
                            <ComboBoxItem Content="{Binding [Lod_High], Source={StaticResource LocalizationService}}" />
                        </ComboBox>
                    </Grid>

                    <!-- 角度捕捉 -->
                    <CheckBox Content="{Binding [Check_AngleSnapping], Source={StaticResource LocalizationService}}"
                              IsChecked="{Binding AngleSnapping}"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Margin="0,0,0,16" />

                    <!-- 保存按钮 -->
                    <Button Content="{Binding [Btn_SaveAdvanced], Source={StaticResource LocalizationService}}"
                            Command="{Binding SaveAdvancedConfigCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch" />

                    <!-- 提示 -->
                    <TextBlock Text="{Binding [Hint_AdvancedSettings], Source={StaticResource LocalizationService}}"
                               Style="{StaticResource HintStyle}"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- 指针加速卡片 -->
            <Border Style="{StaticResource CardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="{Binding [Label_PointerAcceleration], Source={StaticResource LocalizationService}}" Style="{StaticResource CardTitleStyle}" />

                    <!-- 启用开关 -->
                    <CheckBox Content="{Binding [Check_EnablePointerAccel], Source={StaticResource LocalizationService}}"
                              IsChecked="{Binding AccelerationEnabled}"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Margin="0,0,0,20" />

                    <!-- 加速阈值 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding [Label_AccelThreshold], Source={StaticResource LocalizationService}}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                Background="{StaticResource InputBackgroundBrush}"
                                CornerRadius="4"
                                Padding="8,4">
                            <TextBlock Text="{Binding AccelerationThreshold, StringFormat={}{0:F1}}"
                                       FontSize="12"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <Slider Value="{Binding AccelerationThreshold}"
                            Minimum="0"
                            Maximum="50"
                            IsEnabled="{Binding AccelerationEnabled}"
                            Margin="0,0,0,20" />

                    <!-- 加速比 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding [Label_AccelRatio], Source={StaticResource LocalizationService}}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                Background="{StaticResource InputBackgroundBrush}"
                                CornerRadius="4"
                                Padding="8,4">
                            <TextBlock Text="{Binding AccelerationRatio, StringFormat={}{0:F1}x}"
                                       FontSize="12"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <Slider Value="{Binding AccelerationRatio}"
                            Minimum="1"
                            Maximum="3"
                            TickFrequency="0.1"
                            IsEnabled="{Binding AccelerationEnabled}" />

                    <!-- 提示 -->
                    <TextBlock Text="{Binding [Hint_PointerAccel], Source={StaticResource LocalizationService}}"
                               Style="{StaticResource HintStyle}"
                               Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
