<Window x:Class="HidConfigTool.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [Title_Help], Source={StaticResource LocalizationService}}"
        Width="700"
        Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <Path Data="M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20zm0 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16zm0 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm0 4a1 1 0 0 1 1 1v4a1 1 0 0 1-2 0v-4a1 1 0 0 1 1-1z"
                      Fill="{StaticResource AccentBrush}"
                      Width="24" Height="24" Margin="0,0,12,0" />
                <TextBlock Text="{Binding [Help_Title], Source={StaticResource LocalizationService}}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 内容区 -->
        <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 快速开始 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Help_QuickStart], Source={StaticResource LocalizationService}}" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{Binding [Help_Step1_Title], Source={StaticResource LocalizationService}}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding [Help_Step1_Content], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding [Help_Step2_Title], Source={StaticResource LocalizationService}}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding [Help_Step2_Content], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding [Help_Step3_Title], Source={StaticResource LocalizationService}}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding [Help_Step3_Content], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 按键配置 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Help_KeyConfig_Title], Source={StaticResource LocalizationService}}" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{Binding [Help_KeyConfig_1], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [Help_KeyConfig_2], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [Help_KeyConfig_3], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [Help_KeyConfig_4], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 鼠标配置 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Help_MouseConfig_Title], Source={StaticResource LocalizationService}}" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{Binding [Help_MouseConfig_1], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [Help_MouseConfig_2], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [Help_MouseConfig_3], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [Help_MouseConfig_4], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 宏功能 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Help_Macro_Title], Source={StaticResource LocalizationService}}" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{Binding [Help_Macro_1], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [Help_Macro_2], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [Help_Macro_3], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [Help_Macro_4], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [Help_Macro_5], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 配置文件管理 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Help_Profile_Title], Source={StaticResource LocalizationService}}" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{Binding [Help_Profile_1], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [Help_Profile_2], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [Help_Profile_3], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [Help_Profile_4], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 应用感知 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Title_AppAwareness], Source={StaticResource LocalizationService}}" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{Binding [Help_AppAwareness_1], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [Help_AppAwareness_2], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [Help_AppAwareness_3], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 常见问题 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Help_FAQ_Title], Source={StaticResource LocalizationService}}" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{Binding [Help_FAQ_Q1], Source={StaticResource LocalizationService}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding [Help_FAQ_A1], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding [Help_FAQ_Q2], Source={StaticResource LocalizationService}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding [Help_FAQ_A2], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding [Help_FAQ_Q3], Source={StaticResource LocalizationService}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding [Help_FAQ_A3], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding [Help_FAQ_Q4], Source={StaticResource LocalizationService}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding [Help_FAQ_A4], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 技术支持 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Help_Support_Title], Source={StaticResource LocalizationService}}" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{Binding [Help_Support_1], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [Help_Support_2], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [Help_Support_3], Source={StaticResource LocalizationService}}" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 关于与第三方库致谢 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="关于本软件" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="指动 HID 复合设备配置工具" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="版本：v1.0.0" Style="{StaticResource LabelStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="厂商：指动科技" Style="{StaticResource LabelStyle}" Margin="0,0,0,12" />

                        <TextBlock Text="第三方库致谢" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="本软件使用了以下开源第三方库，在此向各项目贡献者表示感谢：" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" Margin="0,0,0,8" />

                        <!-- UI 框架 -->
                        <TextBlock Text="UI 框架" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,4" />
                        <TextBlock Text="• Avalonia UI (MIT) - 跨平台 UI 框架" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="• CommunityToolkit.Mvvm (MIT) - MVVM 工具包" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />

                        <!-- 系统服务 -->
                        <TextBlock Text="系统服务" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,4" />
                        <TextBlock Text="• Microsoft.Extensions.DependencyInjection (MIT) - 依赖注入" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="• Microsoft.Extensions.Hosting (MIT) - 应用程序宿主" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />

                        <!-- 硬件通信 -->
                        <TextBlock Text="硬件通信" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,4" />
                        <TextBlock Text="• HidSharp (Apache 2.0) - 跨平台 HID 设备访问" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />

                        <!-- 测试框架 -->
                        <TextBlock Text="测试框架（开发时使用）" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,4" />
                        <TextBlock Text="• xUnit (Apache 2.0) - 单元测试框架" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="• Moq (BSD 3-Clause) - Mock 框架" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="• coverlet.collector (MIT) - 代码覆盖率收集" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />

                        <!-- 许可证说明 -->
                        <TextBlock Text="许可证说明" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,4" />
                        <TextBlock Text="所有第三方库均使用宽松开源许可证（MIT / BSD 3-Clause / Apache 2.0），允许商业使用、修改和分发。完整许可证信息请参阅随软件分发的 THIRD_PARTY_LICENSES.txt 文件。" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />

                        <!-- 项目链接 -->
                        <TextBlock Text="项目主页" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,4" />
                        <TextBlock Text="https://github.com/JYW-zero/pico_hid_composite" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
