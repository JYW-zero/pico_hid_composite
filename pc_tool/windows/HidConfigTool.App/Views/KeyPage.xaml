<UserControl x:Class="HidConfigTool.App.Views.KeyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:HidConfigTool.App.Localization"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 手指六向按键 DataTemplate -->
            <DataTemplate DataType="{x:Type vmshared:FingerViewModel}"
                          xmlns:vm="clr-namespace:HidConfigTool.ViewModels;assembly=HidConfigTool.ViewModels"
                         xmlns:vmshared="clr-namespace:HidConfigTool.ViewModels;assembly=HidConfigTool.ViewModels">
                <Border Background="{StaticResource InputBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10" />

                        <!-- 六向按键网格 -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 上 -->
                            <Button Grid.Row="0" Grid.Column="1"
                                    Command="{Binding DataContext.EditKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Up}"
                                    Margin="2"
                                    Padding="0,8"
                                    FontSize="11"
                                    HorizontalContentAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel>
                                    <TextBlock Text="↑" FontSize="12" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Up.KeyName}" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="50" />
                                </StackPanel>
                            </Button>

                            <!-- 左 -->
                            <Button Grid.Row="1" Grid.Column="0"
                                    Command="{Binding DataContext.EditKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Left}"
                                    Margin="2"
                                    Padding="0,8"
                                    FontSize="11">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel>
                                    <TextBlock Text="←" FontSize="12" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Left.KeyName}" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="50" />
                                </StackPanel>
                            </Button>

                            <!-- 前（中心，高亮） -->
                            <Button Grid.Row="1" Grid.Column="1"
                                    Command="{Binding DataContext.EditKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Front}"
                                    Margin="2"
                                    Padding="0,8"
                                    FontSize="11">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{StaticResource AccentTransparentBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Foreground" Value="White" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel>
                                    <TextBlock Text="●" FontSize="10" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Front.KeyName}" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="50" />
                                </StackPanel>
                            </Button>

                            <!-- 右 -->
                            <Button Grid.Row="1" Grid.Column="2"
                                    Command="{Binding DataContext.EditKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Right}"
                                    Margin="2"
                                    Padding="0,8"
                                    FontSize="11">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel>
                                    <TextBlock Text="→" FontSize="12" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Right.KeyName}" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="50" />
                                </StackPanel>
                            </Button>

                            <!-- 下 -->
                            <Button Grid.Row="2" Grid.Column="1"
                                    Command="{Binding DataContext.EditKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Down}"
                                    Margin="2"
                                    Padding="0,8"
                                    FontSize="11">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel>
                                    <TextBlock Text="↓" FontSize="12" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Down.KeyName}" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="50" />
                                </StackPanel>
                            </Button>

                            <!-- 后（第二行下方，用单独行） -->
                            <Button Grid.Row="2" Grid.Column="2"
                                    Command="{Binding DataContext.EditKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Back}"
                                    Margin="2"
                                    Padding="0,8"
                                    FontSize="11"
                                    Visibility="Collapsed" />
                        </Grid>

                        <!-- 后键单独显示 -->
                        <Button Command="{Binding DataContext.EditKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Back}"
                                Margin="2,8,2,0"
                                Padding="0,8"
                                FontSize="11"
                                HorizontalContentAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding [Label_BackKey], Source={StaticResource LocalizationService}}" FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Back.KeyName}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="60" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel>
            <!-- 页面标题 -->
            <TextBlock Text="{Binding [Title_KeySettings], Source={StaticResource LocalizationService}}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{Binding [Subtitle_KeySettings], Source={StaticResource LocalizationService}}" Style="{StaticResource PageSubtitleStyle}" />

            <!-- 层切换卡片 -->
            <!-- 编辑层切换卡片（仅用于UI编辑显示，不实际切换设备层） -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="编辑层（选择要修改的层映射）" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="仅切换编辑视图，不影响设备当前生效层" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />

                    <!-- Segmented Control 风格切换 -->
                    <Border Background="{StaticResource InputBackgroundBrush}"
                            CornerRadius="8"
                            Padding="4"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="NormalLayerBtn"
                                    Content="普通层 (Layer 0)"
                                    Command="{Binding SwitchLayerCommand}"
                                    CommandParameter="0"
                                    Padding="20,8"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentLayer}" Value="0">
                                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="FnLayerBtn"
                                    Content="Fn层 (Layer 1)"
                                    Command="{Binding SwitchLayerCommand}"
                                    CommandParameter="1"
                                    Padding="20,8"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="4,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentLayer}" Value="1">
                                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 当前激活层切换卡片（实际发送 CMD_SWITCH_LAYER 到固件，切换设备当前生效层） -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="当前激活层（设备当前生效的层）" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="点击切换设备当前使用的按键层，立即生效（不写入Flash）" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />

                    <!-- 4层 Segmented Control -->
                    <Border Background="{StaticResource InputBackgroundBrush}"
                            CornerRadius="8"
                            Padding="4"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Layer 0"
                                    Command="{Binding ApplyActiveLayerCommand}"
                                    CommandParameter="0"
                                    IsEnabled="{Binding IsDeviceConnected}"
                                    Padding="16,8"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentActiveLayer}" Value="0">
                                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Layer 1"
                                    Command="{Binding ApplyActiveLayerCommand}"
                                    CommandParameter="1"
                                    IsEnabled="{Binding IsDeviceConnected}"
                                    Padding="16,8"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="4,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentActiveLayer}" Value="1">
                                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Layer 2"
                                    Command="{Binding ApplyActiveLayerCommand}"
                                    CommandParameter="2"
                                    IsEnabled="{Binding IsDeviceConnected}"
                                    Padding="16,8"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="4,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentActiveLayer}" Value="2">
                                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Layer 3"
                                    Command="{Binding ApplyActiveLayerCommand}"
                                    CommandParameter="3"
                                    IsEnabled="{Binding IsDeviceConnected}"
                                    Padding="16,8"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="4,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentActiveLayer}" Value="3">
                                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 双手布局卡片 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding [Label_HandAssignment], Source={StaticResource LocalizationService}}" Style="{StaticResource CardTitleStyle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左手 -->
                        <Button Grid.Column="0"
                                Command="{Binding SelectHandCommand}"
                                CommandParameter="Left"
                                Padding="24,20"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="10"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedHand}" Value="Left">
                                            <Setter Property="Background" Value="{StaticResource AccentTransparentBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding [Label_LeftHand], Source={StaticResource LocalizationService}}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="{Binding [Label_LeftHandFingers], Source={StaticResource LocalizationService}}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- 右手 -->
                        <Button Grid.Column="2"
                                Command="{Binding SelectHandCommand}"
                                CommandParameter="Right"
                                Padding="24,20"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="10"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedHand}" Value="Right">
                                            <Setter Property="Background" Value="{StaticResource AccentTransparentBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding [Label_RightHand], Source={StaticResource LocalizationService}}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="{Binding [Label_LeftHandFingers], Source={StaticResource LocalizationService}}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 64键可视化网格概览 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="按键映射概览（8×8 网格）" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="点击任意按键编辑映射，当前编辑层的映射会实时显示" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource InputBackgroundBrush}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentLayer, StringFormat='编辑层: Layer {0}'}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                    </Grid>

                    <!-- 8x8 按键网格 -->
                    <ItemsControl ItemsSource="{Binding Keys}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="8" Rows="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.EditKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="2"
                                        Padding="4,6"
                                        FontSize="10"
                                        Cursor="Hand"
                                        MinHeight="40"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="4"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}" />
                                                                <Setter Property="Foreground" Value="White" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <!-- 已映射的按键高亮显示 -->
                                                <DataTrigger Binding="{Binding KeyCode}" Value="0">
                                                    <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsModifier}" Value="True">
                                                    <Setter Property="Background" Value="#2A2A3A" />
                                                    <Setter Property="Foreground" Value="#FFB74D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding KeyName}"
                                                   FontSize="10"
                                                   FontWeight="Medium"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="55"/>
                                        <TextBlock Text="{Binding Index, StringFormat='#{0}'}"
                                                   FontSize="8"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 图例 -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
                        <Border Background="{StaticResource InputBackgroundBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock Text="未映射" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                        </Border>
                        <Border Background="#2A2A3A" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock Text="修饰键" FontSize="10" Foreground="#FFB74D"/>
                        </Border>
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="8,4">
                            <TextBlock Text="悬停/点击" FontSize="10" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 功能键列表卡片 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding [Label_FunctionKeys], Source={StaticResource LocalizationService}}" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Grid.Column="1" Text="点击按键编辑映射" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding FunctionKeys}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.EditKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,8,8"
                                        Padding="12,8"
                                        FontSize="12"
                                        MinWidth="60"
                                        Cursor="Hand"
                                        HorizontalContentAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="6"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}" />
                                                                <Setter Property="Foreground" Value="White" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding KeyName}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="点击编辑"
                                                   FontSize="9"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 六向按键详情卡片 -->
            <Border Style="{StaticResource CardStyle}" Margin="0">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding [Label_FingerKeyMapping], Source={StaticResource LocalizationService}}"
                                   Style="{StaticResource CardTitleStyle}"
                                   Margin="0"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding ResetDefaultCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,8"
                                    Margin="0,0,8,0"
                                    FontSize="12">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12 5V2L7 7l5 5V8a5 5 0 1 1-5 5H5a7 7 0 1 0 7-8z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="14"
                                          Height="14"
                                          Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding [Btn_Reset], Source={StaticResource LocalizationService}}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SaveToDeviceCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="12,8"
                                    FontSize="12">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M5 3h11l3 3v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm0 2v14h14V6.414L16.586 4H15v4H9V4H5zm4 0v3h6V4H9zm-1 9h8v5H8v-5z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="14"
                                          Height="14"
                                          Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding [Btn_SaveToDevice], Source={StaticResource LocalizationService}}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 手指列表 -->
                    <UniformGrid Columns="5">
                        <ContentControl Content="{Binding LeftHandFingers[0]}" Margin="0,0,8,0" />
                        <ContentControl Content="{Binding LeftHandFingers[1]}" Margin="0,0,8,0" />
                        <ContentControl Content="{Binding LeftHandFingers[2]}" Margin="0,0,8,0" />
                        <ContentControl Content="{Binding LeftHandFingers[3]}" Margin="0,0,8,0" />
                        <ContentControl Content="{Binding LeftHandFingers[4]}" Margin="0" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
