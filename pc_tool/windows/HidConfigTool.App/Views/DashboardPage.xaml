<UserControl x:Class="HidConfigTool.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:HidConfigTool.App.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,20">

            <!-- ==================== 欢迎标题 ==================== -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="欢迎使用"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="{Binding DeviceName}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>

            <!-- ==================== 设备概览卡片 ==================== -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 设备图标 -->
                    <Border Grid.Column="0"
                            Width="64"
                            Height="64"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="16"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                        <TextBlock Text="H"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- 设备信息 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{Binding DeviceName}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <!-- 连接状态指示器 -->
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#F44336"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                                <Setter Property="Fill" Value="#4CAF50"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="未连接"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                                <Setter Property="Text" Value="已连接"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding FirmwareVersion, StringFormat='固件版本: {0}', FallbackValue='固件版本: 未知'}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- 设备详情按钮 -->
                    <Button Grid.Column="2"
                            Content="设备详情"
                            Command="{Binding NavigateToDeviceCommand}"
                            Padding="16,8"
                            FontSize="12"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ==================== 固件更新提示 ==================== -->
            <!-- 固件更新提示 -->
            <Border CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF6D31" Offset="0"/>
                                    <GradientStop Color="#FF8C42" Offset="1"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="🔔 固件更新可用"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding LatestVersion, StringFormat='新版本: {0}，点击立即更新体验最新功能'}"
                                   FontSize="13"
                                   Foreground="White"
                                   Opacity="0.9"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="立即更新"
                            Command="{Binding NavigateToFirmwareUpdateCommand}"
                            Background="White"
                            Foreground="#FF6D31"
                            FontWeight="Bold"
                            Padding="20,10"
                            FontSize="13"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ==================== 快速设置 ==================== -->
            <TextBlock Text="快速设置"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,12"/>

            <UniformGrid Columns="3" Margin="0,0,0,20">
                <!-- 鼠标设置 -->
                <Button Command="{Binding NavigateToMouseCommand}"
                        Margin="0,0,8,8"
                        Padding="16"
                        HorizontalContentAlignment="Left"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderThickness="0"
                        Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="🖱️" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock Text="鼠标设置" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="DPI、轮询率" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Button>

                <!-- 按键设置 -->
                <Button Command="{Binding NavigateToKeyboardCommand}"
                        Margin="8,0,8,8"
                        Padding="16"
                        HorizontalContentAlignment="Left"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderThickness="0"
                        Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="⌨️" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock Text="按键设置" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="键位映射、层切换" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Button>

                <!-- 摇杆设置 -->
                <Button Command="{Binding NavigateToJoystickCommand}"
                        Margin="8,0,0,8"
                        Padding="16"
                        HorizontalContentAlignment="Left"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderThickness="0"
                        Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="🎮" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock Text="摇杆设置" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="死区、灵敏度、校准" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Button>

                <!-- 宏编辑器 -->
                <Button Command="{Binding NavigateToMacroCommand}"
                        Margin="0,8,8,0"
                        Padding="16"
                        HorizontalContentAlignment="Left"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderThickness="0"
                        Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="⚡" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock Text="宏编辑器" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="录制、编辑宏命令" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Button>

                <!-- 固件升级 -->
                <Button Command="{Binding NavigateToFirmwareUpdateCommand}"
                        Margin="8,8,8,0"
                        Padding="16"
                        HorizontalContentAlignment="Left"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderThickness="0"
                        Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="🔄" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock Text="固件升级" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="BOOTSEL UF2 升级" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Button>

                <!-- 设备诊断 -->
                <Button Command="{Binding NavigateToPerfMonitorCommand}"
                        Margin="8,8,0,0"
                        Padding="16"
                        HorizontalContentAlignment="Left"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderThickness="0"
                        Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="📊" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock Text="性能监控" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="实时性能数据" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- ==================== 系统状态 ==================== -->
            <TextBlock Text="系统状态"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,12"/>

            <UniformGrid Columns="2" Margin="0,0,0,0">
                <!-- 错误日志 -->
                <Button Command="{Binding NavigateToErrorLogCommand}"
                        Margin="0,0,8,0"
                        Padding="16"
                        HorizontalContentAlignment="Left"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⚠️" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="错误日志" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding ErrorCount, StringFormat='{}{0} 条记录'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- 性能监控 -->
                <Button Command="{Binding NavigateToPerfMonitorCommand}"
                        Margin="8,0,0,0"
                        Padding="16"
                        HorizontalContentAlignment="Left"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📈" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="性能监控" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="实时性能数据" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </UniformGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
