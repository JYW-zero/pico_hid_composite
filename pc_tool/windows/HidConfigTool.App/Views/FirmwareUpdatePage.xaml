<UserControl x:Class="HidConfigTool.App.Views.FirmwareUpdatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:HidConfigTool.App.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
            <!--  WPF 内置 bool→Visibility；一键/在线 DFU 区按能力位 bit10 显隐  -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>  <!-- 在线升级（推荐） -->
            <RowDefinition Height="Auto"/>  <!-- 本地升级（高级） -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="{Binding [Title_FirmwareUpdate], Source={StaticResource LocalizationService}}"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <!-- 设备信息 -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="当前固件版本:"
                           FontSize="14"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentFirmwareVersion, FallbackValue=未连接}"
                           FontSize="14"
                           VerticalAlignment="Center"/>
                <Ellipse Grid.Column="2"
                         Width="10"
                         Height="10"
                         VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="Red"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                    <Setter Property="Fill" Value="#4CAF50"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Grid>
        </Border>

        <!-- 在线升级（推荐）- 参考 Logitech G HUB / Razer Synapse 一键升级体验。
             仅当固件编入自定义 DFU bootloader（能力位 bit10）时可见；未编入时整块隐藏。 -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12"
                Visibility="{Binding IsDfuUpgradeAvailable, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="在线升级"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Border Background="#4CAF50"
                                CornerRadius="4"
                                Padding="6,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="推荐"
                                       FontSize="10"
                                       Foreground="White"
                                       FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{Binding IsCheckingUpdate, Converter={StaticResource InvertBoolConverter}, ConverterParameter='检查更新'}"
                            Command="{Binding CheckForUpdateCommand}"
                            IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InvertBoolConverter}}"
                            Padding="12,4"
                            FontSize="11"
                            Height="28">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="检查更新" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCheckingUpdate}" Value="True">
                                        <Setter Property="Content" Value="检查中..." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- 检查更新失败提示 -->
                <TextBlock Text="{Binding CheckUpdateError}"
                           FontSize="11"
                           Foreground="#F44336"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CheckUpdateError}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 有可用更新 -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- 版本对比 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="当前:"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentFirmwareVersion}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="→"
                                   FontSize="14"
                                   Foreground="#4CAF50"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="8,0"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding LatestVersion}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#4CAF50"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 更新内容 -->
                    <Border Background="{DynamicResource SubtleBackgroundBrush}"
                            CornerRadius="4"
                            Padding="8"
                            Margin="0,0,0,8">
                        <TextBlock Text="{Binding ReleaseNotes}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxHeight="80"/>
                    </Border>

                    <!-- 下载进度 -->
                    <StackPanel Margin="0,0,0,8">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="正在下载固件..."
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DownloadProgress, StringFormat={}{0}%}"
                                       FontSize="11"
                                       FontWeight="Medium"/>
                        </Grid>
                        <ProgressBar Value="{Binding DownloadProgress}"
                                     Height="4"
                                     Margin="0,4,0,0"
                                     Foreground="#2196F3"/>
                    </StackPanel>

                    <!-- 立即更新按钮 -->
                    <Button Command="{Binding OnlineUpdateCommand}"
                            IsEnabled="{Binding IsUpdating, Converter={StaticResource InvertBoolConverter}}"
                            Padding="16,8"
                            FontSize="13"
                            FontWeight="Bold"
                            HorizontalAlignment="Stretch"
                            Height="40"
                            Background="#4CAF50"
                            Foreground="White">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="立即更新" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                        <Setter Property="Content" Value="正在升级..." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- 已是最新版本 -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsCheckingUpdate}" Value="False"/>
                                        <Condition Binding="{Binding IsUpdateAvailable}" Value="False"/>
                                        <Condition Binding="{Binding CheckUpdateError}" Value="{x:Null}"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
                        <TextBlock Text="✅ " FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="已是最新版本"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="#4CAF50"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 固件选择（本地一键 DFU 选文件，依赖自定义 bootloader）：bit10=0 时隐藏，
             BOOTSEL UF2 为拖盘升级，无需在此选择文件。 -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12"
                Visibility="{Binding IsDfuUpgradeAvailable, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding [Label_FirmwareFile], Source={StaticResource LocalizationService}}"
                           FontSize="14"
                           FontWeight="Medium"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding FirmwarePath, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True"
                             Margin="0,0,8,0"
                             Height="32"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="{Binding [Btn_Browse], Source={StaticResource LocalizationService}}"
                            Command="{Binding SelectFileCommand}"
                            IsEnabled="{Binding IsUpdating, Converter={StaticResource InvertBoolConverter}}"
                            Width="100"
                            Height="32"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 升级进度（一键 DFU 百分比进度，依赖自定义 bootloader）：bit10=0 时隐藏 -->
        <Border Grid.Row="4"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12"
                Visibility="{Binding IsDfuUpgradeAvailable, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Status}"
                               FontSize="14"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Progress, StringFormat={}{0}%}"
                               FontSize="14"
                               FontWeight="Medium"
                               Margin="8,0,0,0"/>
                </Grid>
                <ProgressBar Value="{Binding Progress}"
                             Minimum="0"
                             Maximum="100"
                             Height="8"
                             Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">
            <Button Content="{Binding [Btn_StartUpgrade], Source={StaticResource LocalizationService}}"
                    Command="{Binding StartUpdateCommand}"
                    Width="120"
                    Height="36"
                    Margin="0,0,8,0"
                    Visibility="{Binding IsDfuUpgradeAvailable, Converter={StaticResource BoolToVis}}"/>
            <Button Content="{Binding [Btn_Cancel], Source={StaticResource LocalizationService}}"
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding IsUpdating}"
                    Width="100"
                    Height="36"
                    Margin="0,0,8,0"
                    Visibility="{Binding IsDfuUpgradeAvailable, Converter={StaticResource BoolToVis}}"/>
            <Button Command="{Binding OpenBootselDriveCommand}"
                    Padding="12,6"
                    FontSize="11"
                    Height="36"
                    IsEnabled="{Binding IsEnteringBootsel, Converter={StaticResource InvertBoolConverter}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Content" Value="进入 BOOTSEL 模式" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnteringBootsel}" Value="True">
                                <Setter Property="Content" Value="正在进入..." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- BOOTSEL UF2 说明 -->
        <Border Grid.Row="6"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12">
            <StackPanel>
                <!--  标题随能力位切换：无自定义 DFU bootloader（bit10=0）时 BOOTSEL UF2 即为主推荐  -->
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="BOOTSEL UF2 升级（推荐）"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDfuUpgradeAvailable}" Value="True">
                                    <Setter Property="Text" Value="BOOTSEL UF2 升级（备用）"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="1. 点击上方'进入 BOOTSEL 模式'按钮，设备自动进入 BOOTSEL 模式（软件模拟按住 BOOTSEL 键上电）" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,2" />
                <TextBlock Text="2. 电脑会出现一个名为 RPI-RP2 的 U 盘，程序会自动打开" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,2" />
                <TextBlock Text="3. 将 .uf2 固件文件拖入 U 盘即可完成升级" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,2" />
                <TextBlock Text="备用方案：若软件触发失败，可手动按住 BOOTSEL 键 + 按复位键上电" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>
        </Border>

        <!-- 日志 -->
        <Border Grid.Row="7"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="8"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{Binding [Label_UpgradeLog], Source={StaticResource LocalizationService}}"
                           FontSize="14"
                           FontWeight="Medium"
                           Margin="0,0,0,8"/>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding LogMessages}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
