<UserControl x:Class="HidConfigTool.App.Views.EncoderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel>
            <!-- 页面标题 -->
            <TextBlock Text="编码器设置" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="配置旋转编码器的方向、步长和滚动速度" Style="{StaticResource PageSubtitleStyle}" />

            <!-- 方向设置卡片 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="方向设置" Style="{StaticResource CardTitleStyle}" />

                    <CheckBox Content="反转滚轮方向"
                              IsChecked="{Binding ReverseDirection}"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Margin="0,0,0,12" />
                    <TextBlock Text="开启后，向上滚动变为向下滚动，反之亦然。"
                               Style="{StaticResource HintStyle}" />
                </StackPanel>
            </Border>

            <!-- 步长设置卡片 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="步长设置" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="每格步数"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                Background="{StaticResource InputBackgroundBrush}"
                                CornerRadius="4"
                                Padding="8,4">
                            <TextBlock Text="{Binding StepsPerTick, StringFormat={}{0} 步/格}"
                                       FontSize="12"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <Slider Value="{Binding StepsPerTick}"
                            Minimum="1"
                            Maximum="10"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True" />
                </StackPanel>
            </Border>

            <!-- 滚动速度卡片 -->
            <Border Style="{StaticResource CardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="滚动速度" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="滚动速度倍率"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                Background="{StaticResource InputBackgroundBrush}"
                                CornerRadius="4"
                                Padding="8,4">
                            <TextBlock Text="{Binding ScrollSpeed, StringFormat={}{0}x}"
                                       FontSize="12"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <Slider Value="{Binding ScrollSpeed}"
                            Minimum="1"
                            Maximum="10"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
