<UserControl x:Class="HidConfigTool.App.Views.PerfMonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:HidConfigTool.ViewModels;assembly=HidConfigTool.ViewModels"
             xmlns:conv="clr-namespace:HidConfigTool.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:UiPointListToPointCollectionConverter x:Key="UiPointListToPointCollection" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel>
            <!-- 页面标题 + 控制 -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="性能监控" Style="{StaticResource PageTitleStyle}" Margin="0" />
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{StaticResource AccentBrush}"
                                 Margin="12,0,0,0"
                                 VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPerfMonitorEnabled}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </StackPanel>
                    <TextBlock Text="实时监控设备 CPU、循环频率和任务执行情况" Style="{StaticResource PageSubtitleStyle}" Margin="0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding TogglePerfMonitorCommand}"
                            IsEnabled="{Binding IsDeviceConnected}"
                            Padding="14,8"
                            Margin="0,0,16,0"
                            FontSize="12"
                            MinWidth="90">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Content" Value="开启监控" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPerfMonitorEnabled}" Value="True">
                                        <Setter Property="Content" Value="关闭监控" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="间隔:"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               FontSize="13" />
                    <TextBox Text="{Binding RefreshInterval}"
                             Width="60"
                             VerticalAlignment="Center"
                             Margin="0,0,4,0" />
                    <TextBlock Text="秒"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               FontSize="13" />

                    <Button Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsDeviceConnected}"
                            Padding="14,8"
                            Margin="0,0,8,0"
                            FontSize="12"
                            MinWidth="70">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Content" Value="刷新" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="Content" Value="加载中..." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding ResetCommand}"
                            Content="重置"
                            IsEnabled="{Binding IsDeviceConnected}"
                            Padding="14,8"
                            FontSize="12"
                            MinWidth="70">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 统计卡片 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU使用率 -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="CPU 使用率"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding CpuUsageText, Mode=OneWay}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Bottom" />
                            <TextBlock Grid.Column="1"
                                       Text="%"
                                       FontSize="16"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="4,0,0,6" />
                        </Grid>
                        <ProgressBar Value="{Binding CpuUsage}"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="6"
                                     Margin="0,12,0,0" />
                        <TextBlock FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="0,8,0,0">
                            <Run Text="10s: " />
                            <Run Text="{Binding CpuAvg10sText, Mode=OneWay}" />
                            <Run Text="%  |  30s: " />
                            <Run Text="{Binding CpuAvg30sText, Mode=OneWay}" />
                            <Run Text="%" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 循环频率 -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="主循环频率"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding LoopFreqText, Mode=OneWay}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}"
                                       VerticalAlignment="Bottom" />
                            <TextBlock Grid.Column="1"
                                       Text="Hz"
                                       FontSize="16"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="4,0,0,6" />
                        </Grid>
                        <TextBlock FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="0,12,0,0">
                            <Run Text="每秒循环次数  |  10s平均: " />
                            <Run Text="{Binding LoopFreqAvg10sText, Mode=OneWay}" />
                            <Run Text=" Hz" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 运行时间 -->
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="运行时间"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,12" />
                        <TextBlock Text="{Binding UptimeText, Mode=OneWay}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}"
                                   FontFamily="Consolas" />
                        <TextBlock Text="设备启动后累计运行"
                                   FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- 任务数量 -->
                <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="监控任务"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding TaskCountText, Mode=OneWay}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#BB9AF7"
                                       VerticalAlignment="Bottom" />
                            <TextBlock Grid.Column="1"
                                       Text="个"
                                       FontSize="16"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="4,0,0,6" />
                        </Grid>
                        <TextBlock Text="已注册的监控任务"
                                   FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CPU使用率趋势图 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="140" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="CPU 使用率趋势"
                               Style="{StaticResource CardTitleStyle}"
                               Margin="0" />

                    <!-- 图表区域 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Y轴标签 -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Stretch" HorizontalAlignment="Right">
                            <TextBlock Text="100%" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Height="20" HorizontalAlignment="Right" />
                            <TextBlock Text="75%" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Height="30" HorizontalAlignment="Right" />
                            <TextBlock Text="50%" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Height="30" HorizontalAlignment="Right" />
                            <TextBlock Text="25%" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Height="30" HorizontalAlignment="Right" />
                            <TextBlock Text="0%" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Height="10" HorizontalAlignment="Right" />
                        </StackPanel>

                        <!-- 图表 Canvas -->
                        <Border Grid.Column="2"
                                Background="{StaticResource InputBackgroundBrush}"
                                CornerRadius="8">
                            <Canvas x:Name="ChartCanvas"
                                    Background="Transparent"
                                    Height="140">
                                <!-- 背景网格线 -->
                                <Line X1="0" Y1="0" X2="2000" Y2="0" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />
                                <Line X1="0" Y1="35" X2="2000" Y2="35" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />
                                <Line X1="0" Y1="70" X2="2000" Y2="70" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />
                                <Line X1="0" Y1="105" X2="2000" Y2="105" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />
                                <Line X1="0" Y1="140" X2="2000" Y2="140" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />

                                <!-- CPU折线 -->
                                <Polyline Points="{Binding CpuChartPoints, Converter={StaticResource UiPointListToPointCollection}}"
                                          Stroke="{StaticResource AccentBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                            </Canvas>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 任务详情 -->
            <Border Style="{StaticResource CardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="任务详情"
                               Style="{StaticResource CardTitleStyle}"
                               Margin="0,0,0,16" />

                    <Border Background="{StaticResource InputBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ListView ItemsSource="{Binding TaskStats}"
                                  Background="Transparent"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="任务名称"
                                                    Width="140"
                                                    DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="执行次数"
                                                    Width="90"
                                                    DisplayMemberBinding="{Binding ExecutionCount}" />
                                    <GridViewColumn Header="CPU占比"
                                                    Width="80"
                                                    DisplayMemberBinding="{Binding CpuPercent, StringFormat={}{0}%}" />
                                    <GridViewColumn Header="最小(us)"
                                                    Width="80"
                                                    DisplayMemberBinding="{Binding MinTimeUsDisplay}" />
                                    <GridViewColumn Header="最大(us)"
                                                    Width="80"
                                                    DisplayMemberBinding="{Binding MaxTimeUsDisplay}" />
                                    <GridViewColumn Header="平均(us)"
                                                    Width="80"
                                                    DisplayMemberBinding="{Binding AvgTimeUsDisplay}" />
                                    <GridViewColumn Header="最近(us)"
                                                    Width="80"
                                                    DisplayMemberBinding="{Binding LastTimeUsDisplay}" />
                                    <GridViewColumn Header="超时次数"
                                                    Width="80"
                                                    DisplayMemberBinding="{Binding OverrunCount}" />
                                </GridView>
                            </ListView.View>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
