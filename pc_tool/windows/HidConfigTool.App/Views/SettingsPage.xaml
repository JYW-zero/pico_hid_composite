<UserControl x:Class="HidConfigTool.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel Margin="0,0,16,0">
            <!-- 页面标题 -->
            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="配置应用行为、外观和设备管理选项" Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,20" />

            <!-- 常规设置 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="常规设置" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />
                    <CheckBox Content="最小化到系统托盘"
                              IsChecked="{Binding MinimizeToTray}"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Margin="0,0,0,14" />
                    <CheckBox Content="开机自动启动"
                              IsChecked="{Binding AutoStart}"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Margin="0,0,0,14" />
                    <CheckBox Content="启动时检查更新"
                              IsChecked="{Binding CheckUpdateOnStart}"
                              Style="{StaticResource ToggleSwitchStyle}" />
                </StackPanel>
            </Border>

            <!-- 配置管理 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="配置管理" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Command="{Binding ExportConfigCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 3l5 5h-3v6h-4V8H7l5-5zM5 16h14v3H5v-3z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="14" Height="14" Margin="0,0,8,0" />
                                <TextBlock Text="导出配置" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportConfigCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 21l-5-5h3V8h4v8h3l-5 5zM5 5h14v3H5V5z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="14" Height="14" Margin="0,0,8,0" />
                                <TextBlock Text="导入配置" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ResetConfigCommand}" Style="{StaticResource DangerButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 5V2L7 7l5 5V8a5 5 0 1 1-5 5H5a7 7 0 1 0 7-8z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="14" Height="14" Margin="0,0,8,0" />
                                <TextBlock Text="恢复默认" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HintStyle}" />
                </StackPanel>
            </Border>

            <!-- 配置文件管理 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="配置文件管理" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />
                    <ComboBox x:Name="ProfileComboBox"
                              ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding CurrentProfile}"
                              DisplayMemberPath="Name"
                              MouseDoubleClick="ProfileComboBox_MouseDoubleClick"
                              Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding NewProfileCommand}" Content="新建" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Padding="14,8" FontSize="12" />
                        <Button Command="{Binding RenameProfileCommand}" Content="重命名" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="14,8" FontSize="12" />
                        <Button Command="{Binding DeleteProfileCommand}" Content="删除" Style="{StaticResource DangerButtonStyle}" Padding="14,8" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 应用感知 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="应用感知" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />
                    <CheckBox Content="启用应用感知"
                              IsChecked="{Binding AppAwarenessEnabled}"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Margin="0,0,0,16" />
                    <Border Background="{StaticResource InputBackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="当前前台应用" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding CurrentForegroundApp}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="应用规则" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding AppAwarenessRules}" Height="120" Margin="0,0,0,12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ProcessName}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Command="{Binding DataContext.RemoveAppRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="6">
                                        <Path Data="M9 3h6l1 2h4v2H4V5h4l1-2zm-3 6h12l-1 12a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L6 9z"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Width="12" Height="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Command="{Binding AddAppRuleCommand}" Content="添加规则" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Padding="14,8" FontSize="12" />
                </StackPanel>
            </Border>

            <!-- 固件升级 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="固件升级" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="当前版本" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding CurrentFirmwareVersion}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="最新版本" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding LatestFirmwareVersion}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                        </StackPanel>
                    </Grid>

                    <Button Command="{Binding CheckUpdateCommand}" Content="检查更新" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,16" Padding="14,8" FontSize="12" />

                    <TextBlock Text="固件文件" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding FirmwareFilePath}" IsReadOnly="True" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Command="{Binding SelectFirmwareFileCommand}" Content="选择文件" Style="{StaticResource SecondaryButtonStyle}" Padding="14,8" FontSize="12" />
                    </Grid>

                    <TextBlock Text="升级进度" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                    <ProgressBar Value="{Binding UpdateProgress}" Minimum="0" Maximum="100" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource HintStyle}" Margin="0,0,0,16" />

                    <Button Command="{Binding StartUpdateCommand}"
                            IsEnabled="{Binding IsUpdating, Converter={StaticResource InvertBoolConverter}}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Padding="16,10">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 3l5 5h-3v6h-4V8H7l5-5zM5 16h14v3H5v-3z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="开始升级" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 外观设置 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="外观设置" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />
                    <TextBlock Text="主题" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                    <ComboBox SelectedItem="{Binding Theme}" Margin="0,0,0,16">
                        <ComboBoxItem Content="深色" />
                        <ComboBoxItem Content="浅色" />
                    </ComboBox>
                    <TextBlock Text="语言" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                    <ComboBox SelectedItem="{Binding Language}">
                        <ComboBoxItem Content="简体中文" />
                        <ComboBoxItem Content="English" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="版本" Style="{StaticResource LabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="v0.1.0" Style="{StaticResource ValueStyle}" FontFamily="Consolas" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="作者" Style="{StaticResource LabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="JYW" Style="{StaticResource ValueStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="邮箱" Style="{StaticResource LabelStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="J.YW@outlook.com" Style="{StaticResource ValueStyle}" FontFamily="Consolas" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="技术栈" Style="{StaticResource LabelStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="WPF + .NET 10" Style="{StaticResource ValueStyle}" />
                    </Grid>
                    <Button Content="打开帮助文档"
                            Command="{Binding OpenHelpCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            Padding="20,10" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
