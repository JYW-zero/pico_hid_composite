<Window x:Class="HidConfigTool.App.Views.KeyPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:HidConfigTool.App.Localization"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding [Title_SelectKey], Source={StaticResource LocalizationService}}"
        Height="500"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Margin>
            <Thickness Left="16" Top="16" Right="16" Bottom="16" />
        </Grid.Margin>

        <!-- 搜索框 -->
        <TextBox Grid.Row="0"
                 x:Name="SearchBox"
                 TextChanged="SearchBox_TextChanged"
                 Background="{StaticResource CardBackgroundBrush}"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 BorderBrush="{StaticResource BorderBrush}"
                 BorderThickness="1"
                 Padding="10,8"
                 Margin="0,0,0,12">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                               Padding="{TemplateBinding Padding}">
                                    <ScrollViewer x:Name="PART_ContentHost" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Style>
        </TextBox>

        <!-- 分类标签 -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="{Binding [Btn_All], Source={StaticResource LocalizationService}}"
                    x:Name="AllCategoryButton"
                    Click="CategoryButton_Click"
                    Tag="全部"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="12,6"
                    FontSize="12"
                    Margin="0,0,6,6" />
            <Button Content="{Binding [KeyCat_Letters], Source={StaticResource LocalizationService}}"
                    Click="CategoryButton_Click"
                    Tag="字母"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,6"
                    FontSize="12"
                    Margin="0,0,6,6" />
            <Button Content="{Binding [KeyCat_Numbers], Source={StaticResource LocalizationService}}"
                    Click="CategoryButton_Click"
                    Tag="数字"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,6"
                    FontSize="12"
                    Margin="0,0,6,6" />
            <Button Content="{Binding [Label_FunctionKeys], Source={StaticResource LocalizationService}}"
                    Click="CategoryButton_Click"
                    Tag="功能键"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,6"
                    FontSize="12"
                    Margin="0,0,6,6" />
            <Button Content="{Binding [KeyCat_Edit], Source={StaticResource LocalizationService}}"
                    Click="CategoryButton_Click"
                    Tag="编辑"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,6"
                    FontSize="12"
                    Margin="0,0,6,6" />
            <Button Content="{Binding [KeyCat_Direction], Source={StaticResource LocalizationService}}"
                    Click="CategoryButton_Click"
                    Tag="方向"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,6"
                    FontSize="12"
                    Margin="0,0,6,6" />
            <Button Content="{Binding [KeyCat_Modifier], Source={StaticResource LocalizationService}}"
                    Click="CategoryButton_Click"
                    Tag="修饰键"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,6"
                    FontSize="12"
                    Margin="0,0,6,6" />
            <Button Content="{Binding [KeyCat_Symbol], Source={StaticResource LocalizationService}}"
                    Click="CategoryButton_Click"
                    Tag="符号"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,6"
                    FontSize="12"
                    Margin="0,0,6,6" />
        </WrapPanel>

        <!-- 按键列表 -->
        <ListBox Grid.Row="2"
                 x:Name="KeyListBox"
                 MouseDoubleClick="KeyListBox_MouseDoubleClick"
                 Background="{StaticResource CardBackgroundBrush}"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 BorderBrush="{StaticResource BorderBrush}"
                 BorderThickness="1"
                 Margin="0,0,0,12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Description}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding KeyCode, StringFormat=0x{0:X2}}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding [Btn_Cancel], Source={StaticResource LocalizationService}}"
                    Click="CancelButton_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="20,10"
                    Margin="0,0,12,0" />
            <Button Content="{Binding [Btn_Confirm], Source={StaticResource LocalizationService}}"
                    Click="OkButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="20,10" />
        </StackPanel>
    </Grid>
</Window>

