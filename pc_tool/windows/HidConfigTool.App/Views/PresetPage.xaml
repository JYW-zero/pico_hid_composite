<UserControl x:Class="HidConfigTool.App.Views.PresetPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:HidConfigTool.App.Localization"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding [Title_Presets], Source={StaticResource LocalizationService}}"
                       Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{Binding [Subtitle_Presets], Source={StaticResource LocalizationService}}"
                       Style="{StaticResource PageSubtitleStyle}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- 工具栏 -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 分类筛选 -->
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          Width="120"
                          Margin="0,0,10,0" />

                <!-- 搜索框 -->
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Width="200"
                         Margin="0,0,10,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Escape" Command="{Binding RefreshPresetsCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <!-- 从当前配置创建 -->
                <Button Grid.Column="2"
                        Command="{Binding CreatePresetFromCurrentCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,8"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="14" Height="14" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding [Btn_CreatePreset], Source={StaticResource LocalizationService}}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- 状态消息 -->
                <TextBlock Grid.Column="3"
                           Text="{Binding StatusMessage}"
                           Style="{StaticResource HintStyle}"
                           VerticalAlignment="Center"
                           Margin="10,0,10,0"
                           TextTrimming="CharacterEllipsis" />

                <!-- 刷新按钮 -->
                <Button Grid.Column="4"
                        Command="{Binding RefreshPresetsCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        Padding="8"
                        ToolTip="刷新预设列表">
                    <Path Data="M17.65 6.35A7.958 7.958 0 0012 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0112 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Width="16" Height="16" />
                </Button>
            </Grid>
        </Border>

        <!-- 预设列表 -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FilteredPresets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="280"
                                Margin="0,0,12,12"
                                Padding="16"
                                Background="{StaticResource CardBackgroundBrush}"
                                CornerRadius="10"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                MouseLeftButtonUp="PresetCard_MouseLeftButtonUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <!-- 预设头部 -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 图标 -->
                                    <Border Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            Background="{StaticResource AccentBrush}"
                                            CornerRadius="8"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Icon}"
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 名称和分类 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Border Background="{StaticResource AccentBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="10"
                                                           Foreground="White" />
                                            </Border>
                                            <TextBlock Text="{Binding IsBuiltIn, Converter={StaticResource BoolToBuiltInConverter}}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- 描述 -->
                                <TextBlock Text="{Binding Description}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           MaxHeight="40"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,12" />

                                <!-- 摘要 -->
                                <Border Background="{StaticResource BackgroundBrush}"
                                        CornerRadius="6"
                                        Padding="10"
                                        Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Summary}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               TextWrapping="Wrap" />
                                </Border>

                                <!-- 操作按钮 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 应用按钮 -->
                                    <Button Grid.Column="0"
                                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="12,6"
                                            HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding [Btn_Apply], Source={StaticResource LocalizationService}}"
                                                   FontSize="12" />
                                    </Button>

                                    <!-- 复制按钮 -->
                                    <Button Grid.Column="1"
                                            Command="{Binding DataContext.DuplicatePresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButtonStyle}"
                                            Padding="6"
                                            Margin="6,0,0,0"
                                            ToolTip="复制预设">
                                        <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Width="14" Height="14" />
                                    </Button>

                                    <!-- 删除按钮 -->
                                    <Button Grid.Column="2"
                                            Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButtonStyle}"
                                            Padding="6"
                                            Margin="6,0,0,0"
                                            ToolTip="删除预设"
                                            Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisConverterInverse}}">
                                        <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Width="14" Height="14" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 底部状态栏 -->
        <Border Grid.Row="3"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="10"
                Padding="12,8"
                Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="共 "
                               FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBlock Text="{Binding FilteredPresets.Count}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text=" 个预设"
                               FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
