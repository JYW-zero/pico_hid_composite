<UserControl x:Class="HidConfigTool.App.Views.JoystickPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:HidConfigTool.App.Localization"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel>
            <!-- 页面标题 -->
            <TextBlock Text="{Binding [Title_JoystickSettings], Source={StaticResource LocalizationService}}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{Binding [Subtitle_JoystickSettings], Source={StaticResource LocalizationService}}" Style="{StaticResource PageSubtitleStyle}" />

            <!-- 死区设置卡片 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding [Label_DeadzoneSettings], Source={StaticResource LocalizationService}}"
                                   Style="{StaticResource CardTitleStyle}"
                                   Margin="0"
                                   VerticalAlignment="Center" />
                        <!-- 校准中心点按钮 -->
                        <Button Grid.Column="1"
                                Command="{Binding CalibrateCommand}"
                                IsEnabled="{Binding IsDeviceConnected}"
                                Padding="12,5"
                                FontSize="11"
                                HorizontalAlignment="Right">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Content" Value="校准中心点" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCalibrating}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter Property="Content" Value="校准中..." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- 保存到Flash按钮 -->
                        <Button Grid.Column="3"
                                Command="{Binding SaveConfigCommand}"
                                IsEnabled="{Binding IsDeviceConnected}"
                                Padding="12,5"
                                FontSize="11"
                                HorizontalAlignment="Right">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Content" Value="保存到Flash" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter Property="Content" Value="保存中..." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding [Label_DeadzoneSize], Source={StaticResource LocalizationService}}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                Background="{StaticResource InputBackgroundBrush}"
                                CornerRadius="4"
                                Padding="8,4">
                            <TextBlock Text="{Binding Deadzone}"
                                       FontSize="12"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <Slider Value="{Binding Deadzone}"
                            Minimum="0"
                            Maximum="500"
                            TickFrequency="10" />

                    <TextBlock Text="{Binding [Hint_DeadzoneRealtime], Source={StaticResource LocalizationService}}"
                               Style="{StaticResource HintStyle}"
                               Margin="0,12,0,0" />

                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,8,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- 实时坐标图卡片 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="{Binding [Label_RealtimeCoords], Source={StaticResource LocalizationService}}" Style="{StaticResource CardTitleStyle}" Margin="0" />
                        <TextBlock Text="{Binding [Hint_RealtimeCoords], Source={StaticResource LocalizationService}}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 坐标图 -->
                        <Canvas Grid.Column="0" Width="220" Height="220">
                            <!-- 背景圆 -->
                            <Ellipse Width="220" Height="220"
                                     Stroke="{StaticResource BorderBrush}"
                                     StrokeThickness="1"
                                     Fill="{StaticResource InputBackgroundBrush}" />

                            <!-- 十字线 -->
                            <Line X1="110" Y1="10" X2="110" Y2="210"
                                  Stroke="{StaticResource BorderBrush}"
                                  StrokeThickness="1"
                                  StrokeDashArray="4,4" />
                            <Line X1="10" Y1="110" X2="210" Y2="110"
                                  Stroke="{StaticResource BorderBrush}"
                                  StrokeThickness="1"
                                  StrokeDashArray="4,4" />

                            <!-- 死区圆 -->
                            <Ellipse Width="{Binding DeadzoneCircleWidth}"
                                     Height="{Binding DeadzoneCircleWidth}"
                                     Stroke="{StaticResource AccentBrush}"
                                     StrokeThickness="1"
                                     StrokeDashArray="2,2"
                                     Opacity="0.6"
                                     Canvas.Left="{Binding DeadzoneCircleLeft}"
                                     Canvas.Top="{Binding DeadzoneCircleTop}" />

                            <!-- 摇杆位置点 -->
                            <Ellipse Width="16" Height="16"
                                     Fill="{StaticResource AccentBrush}"
                                     Canvas.Left="{Binding DotLeft}"
                                     Canvas.Top="{Binding DotTop}" />
                        </Canvas>

                        <!-- 数值显示 -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding [Label_XAxis], Source={StaticResource LocalizationService}}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Background="{StaticResource InputBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="8,4">
                                    <TextBlock Text="{Binding JoystickX, StringFormat={}{0:F0}}"
                                               FontSize="13"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontFamily="Consolas"
                                               FontWeight="SemiBold"
                                               MinWidth="40"
                                               TextAlignment="Center" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding [Label_YAxis], Source={StaticResource LocalizationService}}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Background="{StaticResource InputBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="8,4">
                                    <TextBlock Text="{Binding JoystickY, StringFormat={}{0:F0}}"
                                               FontSize="13"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontFamily="Consolas"
                                               FontWeight="SemiBold"
                                               MinWidth="40"
                                               TextAlignment="Center" />
                                </Border>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding [Label_Button], Source={StaticResource LocalizationService}}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Background="{StaticResource InputBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="8,4"
                                        MinWidth="60">
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="松开" />
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding JoystickButton}" Value="True">
                                                        <Setter Property="Text" Value="按下" />
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding [Hint_DeadzoneCircle], Source={StaticResource LocalizationService}}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,16,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 灵敏度设置卡片 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding [Label_Sensitivity], Source={StaticResource LocalizationService}}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding [Label_SensitivityMultiplier], Source={StaticResource LocalizationService}}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                Background="{StaticResource InputBackgroundBrush}"
                                CornerRadius="4"
                                Padding="8,4">
                            <TextBlock Text="{Binding Sensitivity, StringFormat={}{0:0.0}x}"
                                       FontSize="12"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <Slider Value="{Binding Sensitivity}"
                            Minimum="0.5"
                            Maximum="2.0"
                            TickFrequency="0.1" />
                </StackPanel>
            </Border>

            <!-- 方向设置卡片 -->
            <Border Style="{StaticResource CardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="{Binding [Label_DirectionSettings], Source={StaticResource LocalizationService}}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,16" />

                    <CheckBox Content="{Binding [Check_InvertX], Source={StaticResource LocalizationService}}"
                              IsChecked="{Binding InvertX}"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Margin="0,0,0,14" />
                    <CheckBox Content="{Binding [Check_InvertY], Source={StaticResource LocalizationService}}"
                              IsChecked="{Binding InvertY}"
                              Style="{StaticResource ToggleSwitchStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
