<UserControl x:Class="HidConfigTool.App.Views.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:HidConfigTool.App.Localization"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <!-- 页面标题 -->
            <TextBlock Text="{Binding [Title_Diagnostics], Source={StaticResource LocalizationService}}"
                       Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{Binding [Subtitle_Diagnostics], Source={StaticResource LocalizationService}}"
                       Style="{StaticResource PageSubtitleStyle}"
                       Margin="0,0,0,20" />

            <!-- 操作栏 -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding ReadDiagnosticsCommand}"
                            IsEnabled="{Binding IsDeviceConnected}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,10,0"
                            Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 4V1L8 5l4 4V6a6 6 0 1 1-6 6H4a8 8 0 1 0 8-8z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding [Btn_ReadDiagnostics], Source={StaticResource LocalizationService}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            Command="{Binding SaveDiagnosticsCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M19 12v7H5v-7H3v7c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zm-6 .67l2.59-2.58L17 11.5l-5 5-5-5 1.41-1.41L11 12.67V3h2z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding [Btn_SaveReport], Source={StaticResource LocalizationService}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusMessage}"
                               Style="{StaticResource HintStyle}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <!-- 读取进度 -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,16"
                    Visibility="{Binding IsReading, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding [Label_ReadingProgress], Source={StaticResource LocalizationService}}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,8" />
                    <ProgressBar Value="{Binding ReadProgress}"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="{StaticResource BorderBrush}" />
                    <TextBlock Text="{Binding ReadProgress, StringFormat={}{0}%}"
                               FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Border>

            <!-- 健康状态卡片 -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="60" Height="60" Margin="0,0,16,0">
                        <Ellipse Fill="{Binding HealthStatusColor}" Opacity="0.2" />
                        <Ellipse Fill="{Binding HealthStatusColor}"
                                 Width="40" Height="40"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding HealthStatusText}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Label_DeviceHealth], Source={StaticResource LocalizationService}}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 设备信息 -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,16"
                    Visibility="{Binding Diagnostics, Converter={StaticResource NullToCollapsedConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding [Label_DeviceInfo], Source={StaticResource LocalizationService}}"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{Binding [Label_FirmwareVersion], Source={StaticResource LocalizationService}}"
                                       Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding Diagnostics.DeviceInfo.FirmwareVersion}"
                                       Style="{StaticResource ValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding [Label_ProtocolVersion], Source={StaticResource LocalizationService}}"
                                       Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding Diagnostics.DeviceInfo.ProtocolVersion}"
                                       Style="{StaticResource ValueStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 错误日志 -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,16"
                    Visibility="{Binding Diagnostics, Converter={StaticResource NullToCollapsedConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding [Label_ErrorLogs], Source={StaticResource LocalizationService}}"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ErrorLogs.Count, StringFormat={}{0} 条}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <ListBox ItemsSource="{Binding ErrorLogs}"
                             MaxHeight="200"
                             Background="{StaticResource BackgroundBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TimestampMs, StringFormat={}{0}ms}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding LevelName}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Module}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Message}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- 性能统计 -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,16"
                    Visibility="{Binding Diagnostics, Converter={StaticResource NullToCollapsedConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding [Label_PerformanceStats], Source={StaticResource LocalizationService}}"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{Binding [Label_CpuUsage], Source={StaticResource LocalizationService}}"
                                       Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding Diagnostics.PerfSystemStat.CpuUsage, StringFormat={}{0}%}"
                                       Style="{StaticResource ValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,8,0">
                            <TextBlock Text="{Binding [Label_LoopFrequency], Source={StaticResource LocalizationService}}"
                                       Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding Diagnostics.PerfSystemStat.LoopFreqHz, StringFormat={}{0} Hz}"
                                       Style="{StaticResource ValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock Text="{Binding [Label_Uptime], Source={StaticResource LocalizationService}}"
                                       Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding Diagnostics.PerfSystemStat.UptimeFormatted}"
                                       Style="{StaticResource ValueStyle}" />
                        </StackPanel>
                    </Grid>

                    <DataGrid ItemsSource="{Binding TaskStats}"
                              AutoGenerateColumns="False"
                              MaxHeight="200"
                              Background="{StaticResource BackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding [Col_TaskName], Source={StaticResource LocalizationService}}"
                                                Binding="{Binding Name}"
                                                Width="*" />
                            <DataGridTextColumn Header="{Binding [Col_ExecCount], Source={StaticResource LocalizationService}}"
                                                Binding="{Binding ExecutionCount}"
                                                Width="80" />
                            <DataGridTextColumn Header="{Binding [Col_CpuRatio], Source={StaticResource LocalizationService}}"
                                                Binding="{Binding CpuPercent, StringFormat={}{0}%}"
                                                Width="70" />
                            <DataGridTextColumn Header="{Binding [Col_MaxUs], Source={StaticResource LocalizationService}}"
                                                Binding="{Binding MaxTimeUs}"
                                                Width="70" />
                            <DataGridTextColumn Header="{Binding [Col_AvgUs], Source={StaticResource LocalizationService}}"
                                                Binding="{Binding AvgTimeUs}"
                                                Width="70" />
                            <DataGridTextColumn Header="{Binding [Col_TimeoutCount], Source={StaticResource LocalizationService}}"
                                                Binding="{Binding OverrunCount}"
                                                Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 配置 CRC -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,16"
                    Visibility="{Binding Diagnostics, Converter={StaticResource NullToCollapsedConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding [Label_ConfigCrc], Source={StaticResource LocalizationService}}"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{Binding [Label_ConfigVersion], Source={StaticResource LocalizationService}}"
                                       Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding Diagnostics.ConfigCrc.Version, StringFormat=v{0}}"
                                       Style="{StaticResource ValueStyle}" />
                            <TextBlock Text="{Binding [Label_WriteCount], Source={StaticResource LocalizationService}}"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Diagnostics.ConfigCrc.WriteCount}"
                                       Style="{StaticResource ValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding [Label_CrcStatus], Source={StaticResource LocalizationService}}"
                                       Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding Diagnostics.ConfigCrc.IsValid, Converter={StaticResource BoolToStatusConverter}}"
                                       Style="{StaticResource ValueStyle}" />
                            <TextBlock Text="{Binding [Label_StoredCrc], Source={StaticResource LocalizationService}}"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Diagnostics.ConfigCrc.StoredCrc, StringFormat=0x{0:X8}}"
                                       Style="{StaticResource ValueStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- HID 接口信息 -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,16"
                    Visibility="{Binding Diagnostics, Converter={StaticResource NullToCollapsedConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding [Label_HidInterface], Source={StaticResource LocalizationService}}"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="VID / PID"
                                       Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding Diagnostics.HidInterface.VendorId, StringFormat=0x{0:X4} / 0x{1:X4}}"
                                       Style="{StaticResource ValueStyle}" />
                            <TextBlock Text="{Binding [Label_Manufacturer], Source={StaticResource LocalizationService}}"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Diagnostics.HidInterface.Manufacturer}"
                                       Style="{StaticResource ValueStyle}" />
                            <TextBlock Text="{Binding [Label_Product], Source={StaticResource LocalizationService}}"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Diagnostics.HidInterface.Product}"
                                       Style="{StaticResource ValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding [Label_SerialNumber], Source={StaticResource LocalizationService}}"
                                       Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding Diagnostics.HidInterface.SerialNumber}"
                                       Style="{StaticResource ValueStyle}" />
                            <TextBlock Text="{Binding [Label_ReportIdCount], Source={StaticResource LocalizationService}}"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Diagnostics.HidInterface.ReportIds.Count}"
                                       Style="{StaticResource ValueStyle}" />
                            <TextBlock Text="{Binding [Label_DevicePath], Source={StaticResource LocalizationService}}"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Diagnostics.HidInterface.DevicePath}"
                                       Style="{StaticResource ValueStyle}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
